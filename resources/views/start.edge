<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      Commencer - DeckStorm
    </title>
    <link rel="shortcut icon" href="/images/icone.ico" type="image/x-icon" />
    <script>
      (function() {
        let theme = localStorage.getItem("theme");
        if (!theme) theme = "theme-light";
        document.documentElement.className = theme;
        // Sync to body on load
        document.addEventListener("DOMContentLoaded", function() {
          document.body.className = theme;
        });
      })();
    </script>
    <style>
      :root {
        /* Palette Clean (Slate/Zinc) */
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --bg-body: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --success: #22c55e;
        --warning: #f59e0b;
      }
      
      .theme-dark {
        --primary: #60a5fa;
        --primary-dark: #3b82f6;
        --bg-body: #0f172a;
        --bg-card: #1e293b;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border: #334155;
      }
      
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        padding: 2rem 1rem;
        transition: background-color 0.2s, color 0.2s;
      }
      
      /* Universal Theme Selectors */
      
      .theme-light body,
      body.theme-light {
        background: var(--bg-body);
        color: var(--text-main);
      }
      
      .theme-dark body,
      body.theme-dark {
        background: var(--bg-body);
        color: var(--text-main);
      }
      
      .container {
        width: 100%;
        max-width: 1100px;
        margin-top: 4rem;
        gap: 2rem;
        display: grid;
        grid-template-columns: 2fr 1fr;
      }
      
      @media (max-width: 850px) {
        .container {
          grid-template-columns: 1fr;
        }
      }
      
      /* Cards */
      
      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 2rem;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
      }
      
      .section-title {
        font-size: 1.25rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: var(--text-main);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      
      .section-subtitle {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 1rem;
      }
      
      /* Radio Group Grid */
      
      .radio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
      }
      
      /* Radio Card Component */
      
      .radio-card {
        position: relative;
      }
      
      .radio-card input[type="radio"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }
      
      .radio-card-label {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 1.25rem;
        background: var(--bg-card);
        border: 2px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      
      .radio-card-label:hover {
        border-color: var(--primary);
        background: rgba(59, 130, 246, 0.02);
      }
      
      .theme-dark .radio-card-label:hover {
        background: rgba(59, 130, 246, 0.1);
      }
      
      /* Checked State */
      
      .radio-card input[type="radio"]:checked + .radio-card-label {
        border-color: var(--primary);
        background: rgba(59, 130, 246, 0.05);
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.1);
      }
      
      .mode-icon {
        font-size: 1.5rem;
        margin-bottom: 0.8rem;
      }
      
      .mode-title {
        font-weight: 700;
        font-size: 1rem;
        margin-bottom: 0.4rem;
        color: var(--text-main);
      }
      
      .mode-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        line-height: 1.4;
      }
      
      /* Stats / Info Side */
      
      .deck-stat-row {
        display: flex;
        justify-content: space-between;
        padding: 0.8rem 0;
        border-bottom: 1px solid var(--border);
        font-size: 0.95rem;
      }
      
      .deck-stat-row:last-child {
        border-bottom: none;
      }
      
      .stat-label {
        color: var(--text-muted);
      }
      
      .stat-val {
        font-weight: 600;
        color: var(--text-main);
      }
      
      /* Primary Action Button */
      
      .btn-start {
        width: 100%;
        padding: 1.2rem;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 1rem;
      }
      
      .btn-start:hover {
        background: var(--primary-dark);
      }
      
      .btn-cancel {
        display: block;
        text-align: center;
        margin-top: 1rem;
        color: var(--text-muted);
        text-decoration: none;
        font-size: 0.9rem;
      }
      
      .btn-cancel:hover {
        color: var(--text-main);
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    @include('components/header')

    <div class="container">

      <!-- Config Column -->
      <form
        class="card"
        action="{{ route('exercise.presentQuestion', { deckId: deck.id, questionIndex: 0 }) }}"
        method="GET"
        onsubmit="handleSubmit(this)"
      >
        <h1 class="section-title">
          Commencer une session
        </h1>

        <input type="hidden" name="startTime" id="startTime" />
        <input type="hidden" name="results" value="[]" />
        <input type="hidden" name="exerciseToken" value="{{ exerciseToken || '' }}" />

        <!-- Modes -->
        <div class="section-subtitle">
          Mode d'exercice
        </div>
        <div class="radio-grid">

          @if(!deck.allowed_modes || deck.allowed_modes.includes('chronometre'))
            <div class="radio-card">
              <input type="radio" id="mode_chrono" name="mode" value="chronometre" checked />
              <label for="mode_chrono" class="radio-card-label">
                <div class="mode-icon">
                  ⏱
                </div>
                <div class="mode-title">
                  Chronométré
                </div>
                <div class="mode-desc">
                  Répondez le plus vite possible sans erreurs.
                </div>
              </label>
            </div>
          @endif
          
          @if(!deck.allowed_modes || deck.allowed_modes.includes('basique'))
            <div class="radio-card">
              <input type="radio" id="mode_basic" name="mode" value="basique" />
              <label for="mode_basic" class="radio-card-label">
                <div class="mode-icon">
                  📚
                </div>
                <div class="mode-title">
                  Basique
                </div>
                <div class="mode-desc">
                  Parcourez le deck carte par carte, sans stress.
                </div>
              </label>
            </div>
          @endif
          
          @if(!deck.allowed_modes || deck.allowed_modes.includes('jusquaubout'))
            <div class="radio-card">
              <input type="radio" id="mode_jusquaubout" name="mode" value="jusquaubout" />
              <label for="mode_jusquaubout" class="radio-card-label">
                <div class="mode-icon">
                  🎯
                </div>
                <div class="mode-title">
                  Jusqu'au bout
                </div>
                <div class="mode-desc">
                  Répétez les erreurs jusqu'à 100% de réussite.
                </div>
              </label>
            </div>
          @endif
          
          @if(!deck.allowed_modes || deck.allowed_modes.includes('quiz'))
            <div class="radio-card">
              <input type="radio" id="mode_quiz" name="mode" value="quiz" />
              <label for="mode_quiz" class="radio-card-label">
                <div class="mode-icon">
                  ❓
                </div>
                <div class="mode-title">
                  Quiz
                </div>
                <div class="mode-desc">
                  Choisissez la bonne réponse parmi 4 choix.
                </div>
              </label>
            </div>
          @endif
          
        </div>

        <!-- Direction -->
        <div class="section-subtitle">
          Sens d'apprentissage
        </div>
        <div class="radio-grid" style="grid-template-columns: 1fr 1fr;">
          <div class="radio-card">
            <input type="radio" id="dir_qa" name="direction" value="question" checked />
            <label for="dir_qa" class="radio-card-label">
              <div class="mode-title">
                Question → Réponse
              </div>
            </label>
          </div>
          <div class="radio-card">
            <input type="radio" id="dir_aq" name="direction" value="answer" />
            <label for="dir_aq" class="radio-card-label">
              <div class="mode-title">
                Réponse → Question
              </div>
            </label>
          </div>
        </div>

        @if(typeof retryCardIds !== 'undefined' && retryCardIds)
          @each(id in retryCardIds)
            <input type="hidden" name="retryCardIds" value="{{ id }}" />
          @endeach
        @endif
        <input type="hidden" name="attempts" value="{{ attempts || 1 }}" />

        <div style="margin-top: auto;">
          <button type="submit" class="btn-start">🚀 Commencer</button>
          <a href="{{ route('decks.show', { id: deck.id }) }}" class="btn-cancel">Annuler</a>
        </div>
      </form>

      <!-- Info Column -->
      <div class="card">
        <div class="section-subtitle">
          À propos du Deck
        </div>
        <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
          {{ deck.title }}
        </h2>
        <p style="color:var(--text-muted); margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.5;">
          {{ deck.description || 'Aucune description fournie.' }}
        </p>

        <div class="deck-stat-row">
          <span class="stat-label">Cartes</span>
          <span class="stat-val">{{ deck.cards ? deck.cards.length : 0 }}</span>
        </div>
        <div class="deck-stat-row">
          <span class="stat-label">Visibilité</span>
          <span class="stat-val">{{ deck.visibility === 'public' ? 'Public 🌍' : 'Privé 🔒' }}</span>
        </div>
        <div class="deck-stat-row">
          <span class="stat-label">Créateur</span>
          <span class="stat-val">{{ (auth.user && deck.user && auth.user.id === deck.user.id) ? 'Vous' : (deck.user ? deck.user.username : 'Inconnu') }}</span>
        </div>
      </div>

    </div>

    <script>
      function handleSubmit(form) {
        // If Chrono mode, capture start time
        const modeInputs = form.querySelectorAll('input[name="mode"]');
        let selectedMode = "basique";
        modeInputs.forEach(input => {
          if (input.checked) selectedMode = input.value;
        });
        if (selectedMode === "chronometre") {
          document.getElementById("startTime").value = Date.now();
        }
        return true;
      }
    </script>
  </body>
</html>
