<style>
  :root {
    /* Palette de couleurs principale */
    --primary: #1976d2;
    --primary-rgb: 25, 118, 210;
    --primary-color: #1976d2;
    --primary-color-hover: #1565c0;
    
    /* Arrière-plans */
    --bg-body: #f7faff;
    --bg-navbar: rgba(255, 255, 255, 0.95);
    --bg-card: rgba(245, 245, 245, 0.92);
    --bg-input: rgba(245, 245, 245, 0.85);
    --bg-switch: rgba(245, 245, 245, 0.85);
    --bg-top-section: rgba(245, 245, 245, 0.92);
    --bg-like-container: rgba(245, 245, 245, 0.8);
    --bg-creator-item: rgba(25, 118, 210, 0.07);
    
    /* Textes */
    --text-main: #222222;
    --text-muted: #888888;
    --text-inverse: #ffffff;
    
    /* Bordures et Ombres */
    --border-color: rgba(25, 118, 210, 0.10);
    --border-focus: #1976d2;
    --shadow-soft: 0 2px 10px rgba(0, 0, 0, 0.08);
    --shadow-primary: 0 2px 15px rgba(25, 118, 210, 0.10);
    
    /* Transitions */
    --trans-speed: 0.2s;

    /* Header compatibility */
    --header-bg: var(--bg-navbar);
    --header-color: var(--text-main);
    --dropdown-bg: var(--bg-card);
    --dropdown-border: var(--border-color);
  }
  
  body.theme-dark {
    --bg-body: #0a0c10;
    --bg-navbar: rgba(30, 30, 35, 0.95);
    --bg-card: rgba(30, 35, 45, 0.92);
    --bg-input: rgba(40, 45, 55, 0.85);
    --bg-switch: rgba(40, 45, 55, 0.85);
    --bg-top-section: #23272f;
    --bg-like-container: rgba(17, 19, 23, 0.8);
    --bg-creator-item: rgba(25, 118, 210, 0.15);
    
    --text-main: #e6e9ef;
    --text-muted: #a0a0a0;
    --primary-light: rgba(25, 118, 210, 0.3);
    --border-color: rgba(255, 255, 255, 0.10);
    --shadow-soft: 0 2px 10px rgba(0, 0, 0, 0.3);

    /* Header compatibility */
    --header-bg: var(--bg-navbar);
    --header-color: var(--text-main);
    --dropdown-bg: rgba(30, 35, 45, 0.98);
  }

  body {
    background: var(--bg-body);
    color: var(--text-main);
    transition: background 0.4s, color 0.4s;
  }
</style>
