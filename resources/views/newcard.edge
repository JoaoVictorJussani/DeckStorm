<!DOCTYPE html>
<html lang="{{ i18n.locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>
      {{ t('card.new_title') }} - DeckStorm
    </title>
    <link rel="shortcut icon" href="/images/icone.ico" type="image/x-icon" />
    <script>
      (function() {
        let theme = localStorage.getItem("theme");
        if (!theme) theme = "theme-light";
        document.documentElement.className = theme;
        document.addEventListener("DOMContentLoaded", function() {
          document.body.className = theme;
        });
      })();
    </script>
    <style>
      :root {
        /* Palette Clean (Slate/Zinc) */
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --bg-body: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --danger: #ef4444;
        --success: #22c55e;
      }
      
      .theme-dark {
        --primary: #60a5fa;
        --primary-dark: #3b82f6;
        --bg-body: #0f172a;
        --bg-card: #1e293b;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border: #334155;
      }
      
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        padding-top: calc(90px + env(safe-area-inset-top));
        padding-bottom: max(2rem, env(safe-area-inset-bottom));
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        transition: background-color 0.2s, color 0.2s;
      }
      
      .container {
        width: 100%;
        max-width: 600px;
        padding: 3rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      
      .page-header {
        text-align: center;
        margin-bottom: 0.5rem;
      }
      
      .page-title {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      
      .page-subtitle {
        color: var(--text-muted);
        font-size: 1rem;
      }
      
      .edit-card {
        background: var(--bg-card);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        border: 1px solid var(--border);
      }
      
      .form-group {
        margin-bottom: 1.5rem;
      }
      
      .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
        color: var(--text-main);
      }
      
      .form-input,
      .form-textarea {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 2px solid var(--border);
        border-radius: 10px;
        background: var(--bg-body);
        color: var(--text-main);
        font-size: 1rem;
        transition: all 0.2s;
        font-family: inherit;
      }
      
      .form-textarea {
        min-height: 120px;
        resize: vertical;
      }
      
      .form-input:focus,
      .form-textarea:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        background: var(--bg-card);
      }
      
      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2rem;
      }
      
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
      }
      
      .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
      }
      
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);
      }
      
      .btn-secondary {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
      }
      
      .btn-secondary:hover {
        background: rgba(0,0,0,0.05);
        color: var(--text-main);
        border-color: var(--text-muted);
      }
      
      .theme-dark .btn-secondary:hover {
        background: rgba(255,255,255,0.05);
      }
      
      .alert {
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        text-align: center;
        border: 1px solid currentColor;
        font-weight: 500;
        font-size: 0.95rem;
      }
      
      .alert-error {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger);
        border-color: rgba(239, 68, 68, 0.2);
      }
      
      .alert-success {
        background: rgba(34, 197, 94, 0.1);
        color: var(--success);
        border-color: rgba(34, 197, 94, 0.2);
      }
      
      .card-icon {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
      }
      
      @keyframes float {
        0%, 100% {
          transform: translateY(0);
        }
      
        50% {
          transform: translateY(-10px);
        }
      }
    </style>
  </head>
  <body>
    @include('components/header')

    <div class="container">
      @if(!user)
        <div class="edit-card" style="text-align: center;">
          <div class="card-icon">
            🔒
          </div>
          <h2 style="margin-bottom: 1rem;">
            {{ t('card.access_denied') }}
          </h2>
          <p class="alert alert-error">
            {{ t('card.login_required_create') }}
          </p>
          <a href="{{ route('login') }}" class="btn btn-primary">{{ t('auth.login_btn') }}</a>
        </div>
      @else
        <div class="page-header">
          <div class="card-icon">
            🎴
          </div>
          <h1 class="page-title">
            {{ t('card.new_title') }}
          </h1>
          <p class="page-subtitle">
            {{ t('card.new_subtitle') }} <strong>{{ deck.title }}</strong>
          </p>
        </div>

        <form class="edit-card" action="{{ route('cards.store', { deckId: deck.id }) }}" method="POST">
          {{ csrfField() }}
          @if (flashMessages.has('error'))
            <div class="alert alert-error">
              {{ flashMessages.get('error') }}
            </div>
          @endif
          @if (flashMessages.has('success'))
            <div class="alert alert-success">
              {{ flashMessages.get('success') }}
            </div>
          @endif
          
          <div class="form-group">
            <label class="form-label" for="question">{{ t('card.front_label') }}</label>
            <input
              class="form-input"
              type="text"
              id="question"
              name="question"
              value="{{ flashMessages.get('old.question', '') }}"
              required
              placeholder="{{ t('card.front_placeholder') }}"
              autofocus
            />
          </div>

          <div class="form-group">
            <label class="form-label" for="answer">{{ t('card.back_label') }}</label>
            <textarea class="form-textarea" id="answer" name="answer" required placeholder="{{ t('card.back_placeholder') }}">{{ flashMessages.get('old.answer', '') }}</textarea>
          </div>

          <div class="actions">
            <button
              type="button"
              class="btn btn-secondary"
              onclick="window.location.href='{{ route('decks.show', { id: deck.id }) }}'"
            >
              {{ t('deck.cancel_btn') }}
          </button>
            <button type="submit" class="btn btn-primary">
              {{ t('card.add_btn') }}
          </button>
          </div>
        </form>
      @endif
    </div>

  </body>
</html>
