<!DOCTYPE html>
<html lang="{{ i18n.locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>
      Question - DeckStorm
    </title>
    <link rel="shortcut icon" href="/images/icone.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <script>
      (function() {
        let theme = localStorage.getItem("theme");
        if (!theme) theme = "theme-light";
        document.documentElement.className = theme;
        // Sync to body once loaded for compatibility with header scripts
        document.addEventListener("DOMContentLoaded", function() {
          document.body.className = theme;
        });
      })();
    </script>
    <style>
      :root {
        --primary: #4f46e5;
        --primary-hover: #4338ca;
        --success: #10b981;
        --danger: #ef4444;
        --bg-gradient-light: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        --bg-gradient-dark: linear-gradient(135deg, #111827 0%, #1f2937 100%);
        --card-bg-light: #ffffff;
        --card-bg-dark: #1f2937;
        --text-light: #1f2937;
        --text-dark: #f3f4f6;
        --text-muted: #6b7280;
      }
      
      .theme-dark {
        --text-muted: #9ca3af;
      }
      
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      body {
        font-family: 'Outfit', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: background 0.3s ease;
        overflow-x: hidden;
      }
      
      /* Universal Theme Selectors (Works on HTML or BODY) */
      
      .theme-light body,
      body.theme-light {
        background: var(--bg-gradient-light);
        color: var(--text-light);
      }
      
      .theme-dark body,
      body.theme-dark {
        background: var(--bg-gradient-dark);
        color: var(--text-dark);
      }
      
      /* Layout */
      
      .top-bar {
        width: 100%;
        padding-top: max(1.5rem, env(safe-area-inset-top));
        padding-bottom: 1.5rem;
        padding-left: max(2rem, env(safe-area-inset-left));
        padding-right: max(2rem, env(safe-area-inset-right));
        display: grid;
        grid-template-columns: 1fr minmax(200px, 400px) 1fr;
        align-items: center;
        max-width: 1400px;
        margin: 0 auto;
        gap: 1rem;
      }
      
      .top-bar-left {
        justify-self: start;
        display: flex;
        align-items: center;
      }
      
      .top-bar-center {
        justify-self: center;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      
      .top-bar-right {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      
      .progress-container {
        width: 100%;
        margin: 0;
      }
      
      .progress-label {
        text-align: center;
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--text-light);
        opacity: 0.6;
        margin-bottom: 0.5rem;
      }

      body.theme-dark .progress-label {
        color: var(--text-dark);
      }
      
      .progress-track {
        height: 6px;
        background: rgba(0,0,0,0.05);
        border-radius: 10px;
        overflow: hidden;
      }
      
      .theme-dark .progress-track {
        background: rgba(255,255,255,0.1);
      }
      
      .progress-fill {
        height: 100%;
        background: var(--primary);
        width: 0%;
        border-radius: 10px;
        transition: width 0.5s ease;
      }
      
      .quit-btn {
        text-decoration: none;
        color: var(--text-light);
        font-weight: 600;
        opacity: 0.6;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 1rem;
        padding: 0.5rem 0.5rem 0.5rem 0;
      }
      
      body.theme-dark .quit-btn {
        color: var(--text-dark);
      }
      
      .quit-btn:hover {
        opacity: 1;
        transform: translateX(-2px);
      }

      .timer-badge {
         font-family: 'Outfit', monospace;
         font-weight: 600;
         color: var(--primary);
         font-size: 1rem;
         opacity: 0.9;
      }
      
      /* Main Content */
      
      .study-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        width: 100%;
        padding: 2rem;
        padding-bottom: max(2rem, env(safe-area-inset-bottom));
        padding-left: max(2rem, env(safe-area-inset-left));
        padding-right: max(2rem, env(safe-area-inset-right));
        perspective: 1500px;
        /* Depth for 3D flip */
      }
      
      /* Flashcard */
      
      .card-scene {
        width: 100%;
        max-width: 700px;
        aspect-ratio: 16/9;
        position: relative;
        cursor: pointer;
      }
      
      .card {
        width: 100%;
        height: 100%;
        position: relative;
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.4, 0.0, 0.2, 1);
        border-radius: 24px;
        box-shadow: 0 20px 50px rgba(0,0,0,0.1);
      }
      
      .card.is-flipped {
        transform: rotateY(180deg);
      }
      
      .card-face {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 24px;
        padding: 3rem;
        text-align: center;
        background: var(--card-bg-light);
        border: 1px solid rgba(0,0,0,0.05);
      }
      
      body.theme-dark .card-face {
        background: var(--card-bg-dark);
        border-color: rgba(255,255,255,0.05);
        box-shadow: 0 20px 50px rgba(0,0,0,0.3);
      }
      
      .card-face.front {
        /* Front specific styles */
      }
      
      .card-face.back {
        transform: rotateY(180deg);
        background: #f8fafc;
        /* Slightly different for back */
      }
      
      body.theme-dark .card-face.back {
        background: #1a202c;
      }
      
      .card-label {
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: #9ca3af;
        margin-bottom: 1.5rem;
        font-weight: 800;
      }
      
      .card-content {
        font-size: 2rem;
        font-weight: 600;
        line-height: 1.4;
        color: var(--text-light);
      }
      
      body.theme-dark .card-content {
        color: var(--text-dark);
      }
      
      .hint-text {
        position: absolute;
        bottom: 1.5rem;
        font-size: 0.85rem;
        color: #9ca3af;
        opacity: 0.6;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }
      
      /* Controls area (below card) */
      
      .controls-area {
        margin-top: 3rem;
        height: 80px;
        /* reserve space */
        display: flex;
        gap: 2rem;
        width: 100%;
        max-width: 500px;
        justify-content: center;
        opacity: 0;
        transform: translateY(10px);
        transition: all 0.3s ease;
        pointer-events: none;
      }
      
      .controls-area.visible {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
      
      .action-btn {
        flex: 1;
        border: none;
        padding: 1rem 2rem;
        border-radius: 16px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.3rem;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
        color: white;
      }
      
      .action-btn:active {
        transform: scale(0.95);
      }
      
      .action-btn:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
      }
      
      .btn-wrong {
        background: var(--danger);
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
      }
      
      .btn-correct {
        background: var(--success);
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
      }
      
      .btn-sub {
        font-size: 0.8rem;
        font-weight: 400;
        opacity: 0.9;
      }
      
      /* Quiz Mode Styles */
      
      .quiz-container {
        width: 100%;
        max-width: 700px;
      }
      
      .quiz-question-card {
        background: var(--card-bg-light);
        padding: 3rem;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        text-align: center;
        margin-bottom: 2rem;
        font-size: 1.8rem;
        font-weight: 600;
      }
      
      body.theme-dark .quiz-question-card {
        background: var(--card-bg-dark);
      }
      
      .quiz-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
      }
      
      .quiz-option {
        background: transparent;
        border: 2px solid rgba(0,0,0,0.1);
        padding: 1.5rem;
        border-radius: 16px;
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-light);
        cursor: pointer;
        transition: all 0.2s;
      }
      
      body.theme-dark .quiz-option {
        border-color: rgba(255,255,255,0.1);
        color: var(--text-dark);
      }
      
      .quiz-option:hover {
        background: rgba(79, 70, 229, 0.05);
        border-color: var(--primary);
        color: var(--primary);
      }
      
      .quiz-option.correct {
        background: var(--success) !important;
        border-color: var(--success) !important;
        color: white !important;
      }
      
      .quiz-option.wrong {
        background: var(--danger) !important;
        border-color: var(--danger) !important;
        color: white !important;
        opacity: 0.5;
      }
      
      .quiz-option.disabled {
        pointer-events: none;
      }
      
      @media (max-width: 640px) {
        .card-scene {
          aspect-ratio: 3/4; /* Slightly taller for mobile is often better */
          max-height: 65vh;
        }
        
        .card-face {
            padding: 1.5rem;
        }
        
        .card-content {
            font-size: 1.5rem;
        }

        .quiz-grid {
          grid-template-columns: 1fr;
        }

        .controls-area {
          flex-direction: row;
          gap: 0.75rem;
        }
        
        .action-btn {
            padding: 1rem 0.5rem;
            font-size: 1rem;
        }

        .top-bar {
          padding-top: max(1rem, env(safe-area-inset-top));
          padding-left: 1rem;
          padding-right: 1rem;
          padding-bottom: 0.5rem;
          display: flex;
          flex-wrap: wrap;
          gap: 1rem;
        }

        .top-bar-left { order: 1; }
        .top-bar-right { order: 2; margin-left: auto; }
        .top-bar-center {
          order: 3;
          width: 100%;
          margin: 0;
        }
      }

      /* Typed Mode Styles */
      .typed-container {
        width: 100%;
        max-width: 700px;
        display: flex;
        flex-direction: column;
        gap: 2rem;
        align-items: center;
      }
      
      .typed-question-card {
        background: var(--card-bg-light);
        padding: 2.5rem;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        text-align: center;
        font-size: 1.5rem;
        font-weight: 600;
        width: 100%;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
      }
      
      body.theme-dark .typed-question-card {
        background: var(--card-bg-dark);
      }
      
      .typed-input-area {
        width: 100%;
        display: flex;
        gap: 1rem;
      }
      
      .typed-input {
        flex: 1;
        padding: 1.2rem;
        font-size: 1.2rem;
        border: 2px solid rgba(0,0,0,0.1);
        border-radius: 16px;
        background: var(--card-bg-light);
        color: var(--text-light);
        font-family: inherit;
        outline: none;
        transition: all 0.2s;
      }
      
      body.theme-dark .typed-input {
        background: var(--card-bg-dark);
        color: var(--text-dark);
        border-color: rgba(255,255,255,0.1);
      }
      
      .typed-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
      }
      
      .typed-check-btn {
        padding: 0 2.5rem;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 16px;
        font-weight: 700;
        font-size: 1.1rem;
        cursor: pointer;
        transition: background 0.2s;
      }
      
      .typed-check-btn:hover {
        background: var(--primary-hover);
      }
      
      .typed-feedback {
        width: 100%;
        padding: 2rem;
        border-radius: 20px;
        text-align: center;
        display: none;
        animation: slideUp 0.3s ease;
      }
      
      @keyframes slideUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }
      
      .typed-feedback.correct {
        background: rgba(16, 185, 129, 0.1);
        border: 2px solid var(--success);
      }
      
      .typed-feedback.wrong {
        background: rgba(239, 68, 68, 0.1);
        border: 2px solid var(--danger);
      }
      
      .typed-result-title {
        font-weight: 800;
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }
      
      .correct .typed-result-title { color: var(--success); }
      .wrong .typed-result-title { color: var(--danger); }
      
      .typed-answer-display {
        margin: 1.5rem 0;
        font-size: 1.2rem;
        background: rgba(0,0,0,0.05);
        padding: 1rem;
        border-radius: 12px;
      }
      
      body.theme-dark .typed-answer-display {
        background: rgba(255,255,255,0.05);
      }
      
      .typed-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 1.5rem;
      }
      
      /* Text-To-Speech Button */
      /* Text-To-Speech Button */
      .tts-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--primary);
        opacity: 0.6;
        margin-left: 0.5rem;
        transition: all 0.2s;
        vertical-align: middle;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-radius: 50%;
      }
      
      .tts-btn svg {
        width: 1.5rem;
        height: 1.5rem;
        stroke-width: 2;
      }
      
      .tts-btn:hover {
        opacity: 1;
        background: rgba(79, 70, 229, 0.1);
        transform: scale(1.1);
        color: var(--primary-hover);
      }
      
      body.theme-dark .tts-btn:hover {
        background: rgba(255,255,255,0.1);
      }
      
      .tts-btn:active {
        transform: scale(0.95);
      }
      
      .tts-btn.playing {
        animation: pulse-audio 1s infinite;
        color: var(--success);
        opacity: 1;
      }
      
      @keyframes pulse-audio {
        0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); }
        70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); }
        100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
      }

      /* Language Selector Styling */
      .tts-selector-wrapper {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(0,0,0,0.03);
        padding: 0.25rem 0.6rem;
        border-radius: 6px;
        transition: all 0.2s ease;
        border: 1px solid rgba(0,0,0,0.05);
      }
      
      .tts-selector-wrapper:hover {
        background: rgba(0,0,0,0.06);
        border-color: rgba(0,0,0,0.1);
        transform: translateY(-1px);
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
      }
      
      body.theme-dark .tts-selector-wrapper {
        background: rgba(255,255,255,0.03);
        border-color: rgba(255,255,255,0.05);
      }
      
      body.theme-dark .tts-selector-wrapper:hover {
        background: rgba(255,255,255,0.08);
      }
      
      .tts-selector-wrapper:focus-within {
        box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.4);
        border-color: var(--primary);
      }

      .tts-select {
        appearance: none;
        background: transparent;
        border: none;
        font-family: 'Outfit', sans-serif;
        font-family: 'Outfit', sans-serif;
        font-size: 1rem; /* 16px to prevent iOS zoom */
        font-weight: 500;
        color: var(--text-muted);
        cursor: pointer;
        outline: none;
        padding-right: 1rem;
        background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
        background-repeat: no-repeat;
        background-position: right 0 top 55%;
        background-size: 0.6em auto;
        opacity: 0.8;
      }
      
      .tts-selector-wrapper:hover .tts-select {
        color: var(--primary);
        opacity: 1;
        background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%234f46e5%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
      }

      body.theme-dark .tts-select {
        background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%239CA3AF%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
      }
      
      /* SVG Icons helper */
      .icon-sm {
        width: 1.2rem;
        height: 1.2rem;
        stroke-width: 2;
      }
    </style>
  </head>
  <body>

    <div class="top-bar">
      <div class="top-bar-left">
        <a href="{{ route('home') }}" class="quit-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            {{ t('study.quit') }}
        </a>
      </div>

      <div class="top-bar-center">
        <div class="progress-container">
            <div class="progress-label">
            {{ t('study.question_progress', { current: questionIndex + 1, total: (typeof cards !== 'undefined' && cards ? cards.length : deck.cards.length) }) }}
            </div>
            <div class="progress-track">
            <div
                class="progress-fill"
                style="width: {{ ((questionIndex + 1) / (typeof cards !== 'undefined' && cards ? cards.length : deck.cards.length)) * 100 }}%"
            >
            </div>
            </div>
        </div>
      </div>

      <div class="top-bar-right">
          <!-- Timer (Conditional) -->
          @if(mode === 'chronometre')
            <div class="timer-badge" id="elapsed-time">
              0m 0s
            </div>
          @endif

          <!-- TTS Selector (Conditional: Hidden in quiz/typed) -->
          @if(mode !== 'quiz' && mode !== 'typed')
            <div class="tts-selector-wrapper" title="Langue de synthèse vocale / TTS Language">
                 <span style="color: var(--text-muted); display: flex; align-items: center;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line><line x1="8" y1="22" x2="16" y2="22"></line></svg>
                 </span>
                 <select id="tts-lang-select" class="tts-select" onchange="updateTTSLang(this.value)">
                     <option value="fr-FR">Français</option>
                     <option value="en-US">English</option>
                     <option value="es-ES">Español</option>
                     <option value="de-DE">Deutsch</option>
                     <option value="pt-BR">Português</option>
                     <option value="it-IT">Italiano</option>
                     <option value="ja-JP">日本語</option>
                     <option value="zh-CN">中文</option>
                 </select>
            </div>
          @endif
      </div>
    </div>

    <div class="study-container">
      @if(mode === 'quiz')
        <div class="quiz-container">
          <div class="quiz-question-card">
            @if(direction === 'question')
              {{ card.question }}
            @else
              {{ card.answer }}
            @endif
          </div>
          <div class="quiz-grid">
            @if(quizOptions)
              @each(option in quizOptions)
                <button class="quiz-option" onclick="checkQuizAnswer(this, {{ option.isCorrect }})">
                  {{ option.text }}
              </button>
              @endeach
            @endif
          </div>
        </div>
      @elseif(mode === 'typed')
        <div class="typed-container" id="typed-container">
          <div class="typed-question-card">
            @if(card.cardType === 'image_occlusion')
              <div style="width: 100%; height: 300px; display: flex; align-items: center; justify-content: center; position: relative;">
                <canvas id="occlusionCanvas" style="max-width: 100%; max-height: 100%; border-radius: 8px;"></canvas>
              </div>
              <div style="font-size: 1rem; margin-top: 1rem; color: var(--text-muted);">
                {{ direction === 'question' ? 'Quel est le contenu caché ?' : 'Quelle est la question ?' }}
              </div>
            @else
              @if(direction === 'question')
                {{ card.question }}
              @else
                {{ card.answer }}
              @endif
            @endif
          </div>
          
          <input type="hidden" id="hidden-correct-val" value="{{ direction === 'question' ? card.answer : card.question }}" />
          
          <div class="typed-input-area" id="typed-input-area">
            <input 
              type="text" 
              class="typed-input" 
              id="user-typed-answer" 
              placeholder="{{ t('messages.type_your_answer') }}" 
              autocomplete="off"
              onkeydown="if(event.key === 'Enter') checkTypedAnswer()"
              autofocus
            >
            <button class="typed-check-btn" onclick="checkTypedAnswer()">{{ t('messages.check_answer') }}</button>
          </div>
          
          <div class="typed-feedback" id="typed-feedback">
            <div class="typed-result-title" id="feedback-title"></div>
            
            <div class="typed-answer-display">
              <div style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; opacity: 0.7;">{{ t('messages.your_answer') }}</div>
              <div id="feedback-your-answer" style="font-weight: 600;"></div>
            </div>
            
            <div class="typed-answer-display">
              <div style="font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.5rem; opacity: 0.7;">{{ t('messages.correct_answer') }}</div>
              <div id="feedback-correct-answer" style="font-weight: 600; color: var(--success);"></div>
              
              <!-- For image occlusion in review mode -->
              @if(card.cardType === 'image_occlusion')
                 <div style="width: 100%; height: 200px; display: flex; align-items: center; justify-content: center; position: relative; margin-top: 1rem;">
                   <canvas id="occlusionCanvasRevealed" style="max-width: 100%; max-height: 100%; border-radius: 8px;"></canvas>
                 </div>
              @endif
            </div>
            
            <div class="typed-actions">
              <button class="action-btn btn-wrong" onclick="markCard(event, false)" style="padding: 0.8rem 1.5rem; font-size: 1rem;">
                {{ t('study.incorrect') }}
              </button>
              <button class="action-btn btn-correct" onclick="markCard(event, true)" style="padding: 0.8rem 1.5rem; font-size: 1rem;">
                {{ t('messages.continue') }}
              </button>
            </div>
          </div>
        </div>
      @else
        <!-- Flashcard Mode -->
        <div class="card-scene" onclick="flipCard()">
          <div class="card" id="flashcard">
            <div class="card-face front">
              <div class="card-label">
                {{ t('study.details_title').replace('Détail de la session', 'Question').replace('Session Details', 'Question') }}
              </div>
              
              @if(card.cardType === 'image_occlusion')
                <!-- Image Occlusion Card -->
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative;">
                  <canvas id="occlusionCanvas" style="max-width: 100%; max-height: 100%; border-radius: 8px;"></canvas>
                </div>
              @else
                <!-- Text Card -->
                <div class="card-content">
                  @if(direction === 'question')
                    {{ card.question }}
                    <button class="tts-btn" data-text="{{ card.question }}" onclick="speakText(this)" title="{{ t('messages.listen') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
                    </button>
                  @else
                    {{ card.answer }}
                    <button class="tts-btn" data-text="{{ card.answer }}" onclick="speakText(this)" title="{{ t('messages.listen') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>
                    </button>
                  @endif
                </div>
              @endif
              
              <div class="hint-text">
                <span>{{ t('study.flip_hint') }}</span>⟳
              </div>
            </div>
            <div class="card-face back">
              <div class="card-label">
                {{ t('study.direction_aq').replace('Réponse → Question', 'Réponse').replace('Answer → Question', 'Answer') }}
              </div>
              
              @if(card.cardType === 'image_occlusion')
                <!-- Image Occlusion Revealed -->
                <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative;">
                  <canvas id="occlusionCanvasRevealed" style="max-width: 100%; max-height: 100%; border-radius: 8px;"></canvas>
                </div>
              @else
                <!-- Text Card Answer -->
                <div class="card-content">
                  @if(direction === 'question')
                    {{ card.answer }}
                    <button class="tts-btn" data-text="{{ card.answer }}" onclick="speakText(this)" title="{{ t('messages.listen') }}">🔊</button>
                  @else
                    {{ card.question }}
                    <button class="tts-btn" data-text="{{ card.question }}" onclick="speakText(this)" title="{{ t('messages.listen') }}">🔊</button>
                  @endif
                </div>
              @endif
            </div>
          </div>
        </div>

        <div class="controls-area" id="controls">
          <button class="action-btn btn-wrong" onclick="markCard(event, false)">
            <span>{{ t('study.incorrect') }}</span>
            <span class="btn-sub">{{ t('study.to_review') }}</span>
          </button>
          <button class="action-btn btn-correct" onclick="markCard(event, true)">
            <span>{{ t('study.correct') }}</span>
            <span class="btn-sub">{{ t('study.well_done') }}</span>
          </button>
        </div>
      @endif
    </div>

    <!-- Hidden Form for submission -->
    <form action="{{ route('exercise.presentQuestion', { deckId: deck.id, questionIndex: questionIndex + 1 }) }}" method="GET" id="next-form" style="display: none;">
      {{ csrfField() }}
    <input type="hidden" name="startTime" value="{{ startTime }}" />
      <input type="hidden" name="elapsedTime" value="0" />
      <input type="hidden" name="results" id="results" value="{{ results }}" />
      <input type="hidden" name="typedAnswers" id="typedAnswers" value="{{ typedAnswers || '{}' }}" />
      <input type="hidden" name="mode" value="{{ mode }}" />
      <input type="hidden" name="direction" value="{{ direction }}" />
      @if (retryCardIds)
        @each(id in retryCardIds)
          <input type="hidden" name="retryCardIds" value="{{ id }}" />
        @endeach
      @endif
      <input type="hidden" name="attempts" value="{{ attempts || 1 }}" />
      <input type="hidden" name="exerciseToken" value="{{ exerciseToken || '' }}" />
      <button type="submit" id="submitBtn">{{ t('search.next') }}</button>
    </form>

    <script>
      const startTime = parseInt("{{ startTime }}", 10);
      
      const mode = "{{ mode }}";
      
      let results = [];
      let typedAnswers = {};
      try {
        const rawResults = "{{ results }}";
        results = rawResults ? JSON.parse(rawResults.replace(/&quot;/g, '"')) : [];
        
        const rawTyped = `{{ typedAnswers || '{}' }}`.replace(/&quot;/g, '"');
        typedAnswers = JSON.parse(rawTyped);
      } catch (e) {
        console.error("Failed to parse results or typedAnswers:", e);
        results = [];
        typedAnswers = {};
      }
      
      const cardId = parseInt("{{ card.id }}", 10);
      
      let isFlipped = false;
      // Timer logic
      
      if (mode === "chronometre") {
        setInterval(() => {
          const elapsed = Math.floor((Date.now() - startTime) / 1e3);
          document.getElementById("elapsed-time").textContent = `${Math.floor(elapsed / 60)}m ${elapsed % 60}s`;
          const elapsedInput = document.querySelector('input[name="elapsedTime"]');
          if (elapsedInput) elapsedInput.value = elapsed;
        }, 1e3);
      }
      // Flashcard Logic
      
      function flipCard() {
        if (mode !== "quiz") {
          const card = document.getElementById("flashcard");
          const controls = document.getElementById("controls");
          isFlipped = !isFlipped;
          card.classList.toggle("is-flipped");
          if (isFlipped) {
            controls.classList.add("visible");
          } else {
            controls.classList.remove("visible");
          }
        }
      }
      
      function markCard(event, isCorrect) {
        if (event) event.stopPropagation();
        if (isCorrect) {
          results.push(cardId);
        }
        document.getElementById("results").value = JSON.stringify(results);
        document.getElementById("typedAnswers").value = JSON.stringify(typedAnswers);
        // Submit immediately
        document.getElementById("next-form").submit();
      }
      // Text-To-Speech Logic
      let synth = window.speechSynthesis;
      let currentUtterance = null;
      // Default to French or browser default, but will be overwritten by selector
      let selectedLang = localStorage.getItem('deckstorm_tts_lang') || 'fr-FR';

      // Set initial value of selector
      document.addEventListener("DOMContentLoaded", () => {
          const sel = document.getElementById('tts-lang-select');
          if(sel) {
              sel.value = selectedLang;
          }
      });

      function updateTTSLang(lang) {
          selectedLang = lang;
          localStorage.setItem('deckstorm_tts_lang', lang);
      }

      function speakText(btn, textOverride) {
        if (event) event.stopPropagation(); // Prevent card flip
        
        const text = textOverride || btn.getAttribute('data-text');
        if (!text) return;
        
        // If speaking, stop.
        if (synth.speaking) {
          synth.cancel();
          document.querySelectorAll('.tts-btn').forEach(b => b.classList.remove('playing'));
          // If we clicked the same button, just stop.
          if (btn.classList.contains('playing')) return; 
        }

        const utterance = new SpeechSynthesisUtterance(text);
        
        // Use the selected language
        utterance.lang = selectedLang; 

        utterance.onstart = () => {
          btn.classList.add('playing');
        };
        
        utterance.onend = () => {
          btn.classList.remove('playing');
          currentUtterance = null;
        };
        
        utterance.onerror = () => {
            btn.classList.remove('playing');
        }

        currentUtterance = utterance;
        synth.speak(utterance);
      }
      
      // Quiz Logic
      
      function checkQuizAnswer(btn, isCorrect) {
        if (btn.classList.contains("disabled")) return;
        const allBtns = document.querySelectorAll(".quiz-option");
        allBtns.forEach(b => {
          b.classList.add("disabled");
        });
        if (isCorrect) {
          btn.classList.add("correct");
          results.push(cardId);
        } else {
          btn.classList.add("wrong");
          // Highlight correct one
          allBtns.forEach(b => {
            const onclickStr = b.getAttribute("onclick");
            if (onclickStr && onclickStr.includes(", true)")) {
              b.classList.add("correct");
            }
          });
        }
        document.getElementById("results").value = JSON.stringify(results);
        // Slight delay before next question
        setTimeout(() => {
          document.getElementById("next-form").submit();
        }, 1200);
      }
      
      // Typed Mode Logic
      function checkTypedAnswer() {
        if (mode !== 'typed') return;
        
        const input = document.getElementById('user-typed-answer');
        const feedback = document.getElementById('typed-feedback');
        const inputArea = document.getElementById('typed-input-area');
        const title = document.getElementById('feedback-title');
        const yourAns = document.getElementById('feedback-your-answer');
        const correctAns = document.getElementById('feedback-correct-answer');
        
        const userValue = input.value.trim();
        // Read from hidden input to handle special chars/newlines safely
        const correctValInput = document.getElementById('hidden-correct-val');
        const correctValue = correctValInput ? correctValInput.value : "";
        
        // Store user answer
        typedAnswers[cardId] = userValue;
        
        // Simple normalization for comparison (lowercase, trim)
        const normalize = (s) => s.toLowerCase().trim().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g,"");
        const isMatch = normalize(userValue) === normalize(correctValue);
        
        // Show feedback UI
        inputArea.style.display = 'none';
        feedback.style.display = 'block';
        yourAns.textContent = userValue;
        correctAns.textContent = correctValue;
        
        const continueBtn = feedback.querySelector('.btn-correct');
        const overrideBtn = feedback.querySelector('.btn-wrong');
        
        if (isMatch) {
          feedback.className = 'typed-feedback correct';
          title.textContent = "{{ t('messages.answer_correct') }}";
          continueBtn.textContent = "{{ t('messages.continue') }}"; // It was correct, so continue adds points
          
          // Auto-focus the continue button
          setTimeout(() => continueBtn.focus(), 50);
        } else {
          feedback.className = 'typed-feedback wrong';
          title.textContent = "{{ t('messages.answer_incorrect') }}";
          continueBtn.textContent = "{{ t('messages.continue') }} (Mark as IDK)"; 
          // Actually if wrong, the primary action should be "Mark Incorrect" usually, 
          // or user can "Override I was right".
          // Let's swap buttons logic for wrong answer?
          // If wrong: 
          //   Green button -> "I was right" (Override TRUE)
          //   Red button -> "I was wrong" (Standard FALSE)
          
          overrideBtn.textContent = "{{ t('study.incorrect') }}";
          overrideBtn.onclick = (e) => markCard(e, false);
          
          continueBtn.textContent = "{{{ t('messages.force_correct') }}}";
          continueBtn.style.background = '#f59e0b'; // Orange/Yellow for override
          continueBtn.style.fontSize = '0.9rem';
          continueBtn.onclick = (e) => markCard(e, true);
        }
      }
      // Progress Bar Animation
      
      document.addEventListener("DOMContentLoaded", () => {
        // Small delay to trigger CSS transition
        setTimeout(() => {
          const fill = document.querySelector(".progress-fill");
          // We might need to recalculate width if it relies on server side render
          // It is already inline style, so it should animate on load if we wanted. 
          // But for smooth entry, we can zero it first? 
          // Actually current implementation sets width in HTML so it will just be there.
        }, 100);
        
        // Image Occlusion Rendering
        const cardType = "{{ card.cardType || 'text' }}";
        if (cardType === "image_occlusion") {
          const imagePath = "{{ card.imagePath }}";
          const occlusionZonesStr = `{{ JSON.stringify(card.occlusionZones || []) }}`.replace(/&quot;/g, '"');
          let occlusionZones = [];
          
          try {
            occlusionZones = JSON.parse(occlusionZonesStr);
          } catch (e) {
            console.error("Failed to parse occlusion zones:", e);
          }
          
          const zoneColors = [
            '#ef4444', '#f59e0b', '#10b981', '#3b82f6', 
            '#8b5cf6', '#ec4899', '#14b8a6', '#f97316'
          ];
          
          // Load and render front (with occlusions)
          const canvasFront = document.getElementById("occlusionCanvas");
          const ctxFront = canvasFront ? canvasFront.getContext("2d") : null;
          
          // Load and render back (revealed)
          const canvasBack = document.getElementById("occlusionCanvasRevealed");
          const ctxBack = canvasBack ? canvasBack.getContext("2d") : null;
          
          if (imagePath && (ctxFront || ctxBack)) {
            const img = new Image();
            img.onload = () => {
              const maxWidth = 600;
              const scale = Math.min(1, maxWidth / img.width);
              const width = img.width * scale;
              const height = img.height * scale;
              
              // Setup front canvas (with occlusions)
              if (canvasFront && ctxFront) {
                canvasFront.width = width;
                canvasFront.height = height;
                ctxFront.drawImage(img, 0, 0, width, height);
                
                // Draw occlusion zones (convert percentages to pixels)
                occlusionZones.forEach((zone, index) => {
                  const x = zone.x * width;
                  const y = zone.y * height;
                  const zoneWidth = zone.width * width;
                  const zoneHeight = zone.height * height;
                  
                  ctxFront.fillStyle = zoneColors[index % zoneColors.length];
                  ctxFront.fillRect(x, y, zoneWidth, zoneHeight);
                  
                  // Draw zone number
                  ctxFront.fillStyle = '#ffffff';
                  ctxFront.font = 'bold 24px Arial';
                  ctxFront.textAlign = 'center';
                  ctxFront.textBaseline = 'middle';
                  ctxFront.fillText(zone.id, x + zoneWidth / 2, y + zoneHeight / 2);
                });
              }
              
              // Setup back canvas (revealed - just the image)
              if (canvasBack && ctxBack) {
                canvasBack.width = width;
                canvasBack.height = height;
                ctxBack.drawImage(img, 0, 0, width, height);
                
                // Draw zone outlines for reference (convert percentages to pixels)
                occlusionZones.forEach((zone, index) => {
                  const x = zone.x * width;
                  const y = zone.y * height;
                  const zoneWidth = zone.width * width;
                  const zoneHeight = zone.height * height;
                  
                  ctxBack.strokeStyle = zoneColors[index % zoneColors.length];
                  ctxBack.lineWidth = 3;
                  ctxBack.strokeRect(x, y, zoneWidth, zoneHeight);
                  
                  // Draw zone number in corner
                  ctxBack.fillStyle = zoneColors[index % zoneColors.length];
                  ctxBack.font = 'bold 16px Arial';
                  ctxBack.textAlign = 'left';
                  ctxBack.textBaseline = 'top';
                  ctxBack.fillText(zone.id, x + 5, y + 5);
                });
              }
            };
            img.src = imagePath;
          }
        }
      });
    </script>
  </body>
</html>
