      </div>
    </div>

    <script>
      const textarea = document.getElementById("description");
      
      const charCount = document.getElementById("charCount");
      
      function updateCounter() {
        const currentLength = textarea.value.length;
        charCount.textContent = currentLength;
        // Change la couleur quand on approche de la limite
        if (currentLength >= 100) {
          charCount.style.color = "#ff4d4d"; // Rouge
        } else if (currentLength >= 80) {
          charCount.style.color = "#ffa500"; // Orange
        } else {
          charCount.style.color = "#1976d2"; // Couleur par défaut
        }
      }
      // Initialisation au chargement
      
      document.addEventListener("DOMContentLoaded", () => {
        updateCounter();
        switchMethod('manual'); // Set initial method to manual
      });
      // Mise à jour à chaque changement
      
      textarea.addEventListener("input", updateCounter);

      function switchMethod(method) {
        const manualForm = document.getElementById('manual-form');
        const aiForm = document.getElementById('ai-form');
        const btnManual = document.getElementById('method-manual');
        const btnAi = document.getElementById('method-ai');

        if (method === 'manual') {
          manualForm.style.display = 'flex';
          aiForm.style.display = 'none';
          btnManual.classList.add('active');
          btnAi.classList.remove('active');
        } else {
          manualForm.style.display = 'none';
          aiForm.style.display = 'flex';
          btnManual.classList.remove('active');
          btnAi.classList.add('active');
        }
      }

      function switchAiInput(mode) {
        const groupTopic = document.getElementById('ai-group-topic');
        const groupText = document.getElementById('ai-group-text');
        const btnTopic = document.getElementById('btn-mode-topic');
        const btnText = document.getElementById('btn-mode-text');
        const modeInput = document.getElementById('ai-mode-input');
        const topicArea = document.getElementById('topic');
        const textArea = document.getElementById('source_text');

        modeInput.value = mode;

        if (mode === 'topic') {
          groupTopic.style.display = 'block';
          groupText.style.display = 'none';
          btnTopic.classList.add('active');
          btnText.classList.remove('active');
          topicArea.setAttribute('required', '');
          textArea.removeAttribute('required');
        } else {
          groupTopic.style.display = 'none';
          groupText.style.display = 'block';
          btnTopic.classList.remove('active');
          btnText.classList.add('active');
          topicArea.removeAttribute('required');
          textArea.setAttribute('required', '');
        }
      }

      const magicForm = document.getElementById('magic-form');
      const loadingOverlay = document.getElementById('ai-loading');
      const loadingText = document.getElementById('loading-text');

      if (magicForm) {
        magicForm.addEventListener('submit', () => {
          loadingOverlay.style.display = 'flex';
          
          const steps = [
            "{{ t('messages.ai.generating_step_1') }}",
            "{{ t('messages.ai.generating_step_2') }}",
            "{{ t('messages.ai.generating_step_3') }}",
            "{{ t('messages.ai.generating_step_4') }}"
          ];
          let stepIdx = 0;
          setInterval(() => {
            stepIdx = (stepIdx + 1) % steps.length;
            loadingText.textContent = steps[stepIdx];
          }, 2500);
        });
      }
    </script>
  </body>
</html>
