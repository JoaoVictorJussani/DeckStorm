<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>{{ group.name }} - DeckStorm</title>
    <style>
      :root {
        --primary: #1976d2;
        --primary-rgb: 25, 118, 210;
        --primary-hover: #1565c0;
        --primary-light: #e3f2fd;
        --bg-body: #f7faff;
        --bg-navbar: rgba(255, 255, 255, 0.95);
        --bg-card: rgba(255, 255, 255, 0.95);
        --text-main: #222222;
        --text-muted: #666666;
        --text-inverse: #ffffff;
        --border-color: rgba(25, 118, 210, 0.12);
        --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.05);
        --shadow-hover: 0 8px 30px rgba(25, 118, 210, 0.15);
        
        /* Stats Colors */
        --success: #10b981;
        --success-bg: rgba(16, 185, 129, 0.1);
        --warning: #f59e0b;
        --warning-bg: rgba(245, 158, 11, 0.15);
        --info: #3b82f6;
        --info-bg: rgba(59, 130, 246, 0.1);
        --danger: #ef4444;
        --danger-bg: rgba(239, 68, 68, 0.1);
      }
      body.theme-dark {
        --bg-body: #0a0c10;
        --bg-navbar: rgba(30, 30, 35, 0.95);
        --bg-card: rgba(30, 35, 45, 0.6);
        --text-main: #e6e9ef;
        --text-muted: #a0a0a0;
        --primary-light: rgba(25, 118, 210, 0.2);
        --border-color: rgba(255, 255, 255, 0.10);
        --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.3);
      }
      body { background: var(--bg-body); color: var(--text-main); font-family: 'Segoe UI', sans-serif; transition: background 0.4s, color 0.4s; margin: 0; padding: 0; }
      * { box-sizing: border-box; }
      
      .main-content { max-width: 1400px; margin: 100px auto; padding: 2rem; } /* Increased max-width for sidebar layout */
      
      /* Navigation */
      .back-link { 
        display: inline-flex; align-items: center; gap: 0.5rem; 
        color: var(--text-muted); text-decoration: none; font-weight: 600; 
        margin-bottom: 2rem; transition: color 0.2s; 
      }
      .back-link:hover { color: var(--primary); }

      /* Hero/Header Section */
      .group-header {
        background: var(--bg-card);
        border-radius: 20px;
        padding: 2.5rem;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--border-color);
        margin-bottom: 2.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        backdrop-filter: blur(10px);
      }
      
      @media(min-width: 768px) {
        .group-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
      }

      .group-info h1 { font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--primary); font-weight: 800; line-height: 1.2; }
      .group-info p { font-size: 1.1rem; color: var(--text-muted); line-height: 1.6; max-width: 600px; }

      /* Invite Code Card */
      .invite-card {
        background: linear-gradient(135deg, var(--bg-body), var(--bg-card));
        border: 2px dashed var(--primary);
        padding: 1.2rem 2rem;
        border-radius: 16px;
        text-align: center;
        min-width: 250px;
        position: relative;
        transition: transform 0.2s;
        cursor: pointer;
      }
      .invite-card:hover { transform: scale(1.02); background: var(--primary-light); }
      .invite-label { text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: bold; }
      .invite-code { font-size: 2.2rem; font-family: 'Courier New', monospace; font-weight: bold; color: var(--primary); letter-spacing: 3px; }
      .click-to-copy { font-size: 0.75rem; color: var(--primary); opacity: 0; transition: opacity 0.2s; margin-top: 0.2rem; }
      .invite-card:hover .click-to-copy { opacity: 1; }

      .teacher-badge {
          display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;
          background: var(--primary-light); color: var(--primary); border-radius: 50px; font-weight: 600;
      }

      /* Dashboard Grid Layout (New) */
      .dashboard-layout {
        display: grid;
        grid-template-columns: 1fr 300px; /* Main Content | Sidebar */
        gap: 2rem;
        align-items: start;
      }
      
      @media (max-width: 1024px) {
        .dashboard-layout {
          grid-template-columns: 1fr; /* Stack on smaller screens */
        }
      }

      /* Stats Grid (Now in Sidebar) */
      .stats-sidebar { 
        display: flex; 
        flex-direction: column; 
        gap: 1.5rem; 
        position: sticky;
        top: 120px; /* Sticky sidebar */
      }
      
      /* On mobile, stats grid goes back to grid or row */
      @media (max-width: 1024px) {
        .stats-sidebar {
           display: grid;
           grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
           position: static;
           margin-bottom: 2rem;
        }
      }

      .stat-card { background: var(--bg-card); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft); position: relative; overflow: hidden; }
      .stat-card::before { content:''; position: absolute; top:0; left:0; width: 4px; height: 100%; background: var(--primary); }
      .stat-card-icon { width: 50px; height: 50px; background: var(--primary-light); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; color: var(--primary); }
      .stat-card-info { display: flex; flex-direction: column; }
      .stat-card-value { font-size: 1.8rem; font-weight: 800; color: var(--text-main); line-height: 1; }
      .stat-card-label { font-size: 0.9rem; color: var(--text-muted); font-weight: 600; margin-top: 0.4rem; }

      /* Podium Section */
      .podium-section { display: flex; justify-content: center; align-items: flex-end; gap: 1rem; margin-bottom: 3rem; margin-top: 0; }
      .podium-step { display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
      .podium-step:hover { transform: translateY(-10px); }
      .podium-avatar { width: 80px; height: 80px; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 10px 20px rgba(0,0,0,0.1); z-index: 2; margin-bottom: -15px; background: #eee; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 2rem; color: #555; }
      body.theme-dark .podium-avatar { border-color: #2d3748; color: #fff; }
      
      .podium-block { width: 100px; border-radius: 12px 12px 4px 4px; display: flex; align-items: flex-end; justify-content: center; padding-bottom: 1rem; color: #fff; font-weight: 900; font-size: 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.1); position: relative; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
      
      /* First Place */
      .step-1 { z-index: 3; }
      .step-1 .podium-block { height: 160px; background: linear-gradient(135deg, #FFD700, #FDB931); }
      .step-1 .podium-avatar { border-color: #FFD700; width: 100px; height: 100px; font-size: 2.5rem; margin-bottom: -20px; color: #B8860B; background: #FFF8E1; }
      
      /* Second Place */
      .step-2 { z-index: 2; }
      .step-2 .podium-block { height: 120px; background: linear-gradient(135deg, #E0E0E0, #BDBDBD); }
      .step-2 .podium-avatar { border-color: #E0E0E0; color: #757575; background: #FAFAFA; }
      
      /* Third Place */
      .step-3 { z-index: 1; }
      .step-3 .podium-block { height: 90px; background: linear-gradient(135deg, #CD7F32, #A0522D); }
      .step-3 .podium-avatar { border-color: #CD7F32; color: #8B4513; background: #FFF3E0; }

      .podium-name { margin-top: 1rem; font-weight: 700; color: var(--text-main); font-size: 1.1rem; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .podium-score { color: var(--text-muted); font-size: 0.9rem; font-weight: 600; }

      /* Members Table Section */
      .members-section {
        background: transparent; /* Changed from card to transparent to let rows float */
        border-radius: 20px;
        padding: 0;
        box-shadow: none;
        border: none;
      }
      
      .table-header { 
          display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; 
          padding: 1.5rem 2rem; background: var(--bg-card); border-radius: 16px; border: 1px solid var(--border-color); box-shadow: var(--shadow-soft);
      }
      .table-title { font-size: 1.5rem; font-weight: 700; display: flex; align-items: center; gap: 0.8rem; color: var(--text-main); margin: 0; }
      .member-count { background: var(--primary); color: #fff; padding: 0.2rem 0.8rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; box-shadow: 0 4px 10px rgba(25, 118, 210, 0.3); }

      .custom-table { 
          width: 100%; 
          border-collapse: separate; 
          border-spacing: 0 0.8rem; /* Space between rows */
      }
      
      .custom-table th { 
        text-align: left; padding: 0.5rem 2rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px;
        border: none;
      }
      
      .custom-table tr.member-row {
          transition: transform 0.2s, box-shadow 0.2s;
      }
      
      .custom-table tr.member-row:hover {
          transform: translateY(-3px);
      }
      
      .custom-table td { 
          padding: 1rem 2rem; 
          background: var(--bg-card);
          border-top: 1px solid var(--border-color);
          border-bottom: 1px solid var(--border-color);
          vertical-align: middle; 
      }
      
      .custom-table td:first-child {
          border-left: 1px solid var(--border-color);
          border-top-left-radius: 16px;
          border-bottom-left-radius: 16px;
      }
      
      .custom-table td:last-child {
          border-right: 1px solid var(--border-color);
          border-top-right-radius: 16px;
          border-bottom-right-radius: 16px;
      }
      
      /* Rank Cell */
      .rank-cell { 
          font-weight: 900; color: var(--text-muted); font-size: 1.2rem; width: 40px; height: 40px; 
          display: flex; align-items: center; justify-content: center; border-radius: 50%;
          background: rgba(0,0,0,0.03); margin: 0 auto;
      }
      
      /* Top 3 Ranks Sytling */
      .member-row.rank-1 td { background: linear-gradient(90deg, #fff9ea 0%, #fff 100%); border-color: rgba(255, 215, 0, 0.3); }
      .rank-cell.rank-1 { background: linear-gradient(135deg, #FFD700, #FDB931); color: #fff; box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3); font-size: 1.5rem; }
      
      .member-row.rank-2 td { background: linear-gradient(90deg, #f7f7f7 0%, #fff 100%); border-color: rgba(192, 192, 192, 0.3); }
      .rank-cell.rank-2 { background: linear-gradient(135deg, #E0E0E0, #BDBDBD); color: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.1); font-size: 1.2rem; }
      
      .member-row.rank-3 td { background: linear-gradient(90deg, #fff0e5 0%, #fff 100%); border-color: rgba(205, 127, 50, 0.3); }
      .rank-cell.rank-3 { background: linear-gradient(135deg, #CD7F32, #A0522D); color: #fff; box-shadow: 0 4px 10px rgba(205, 127, 50, 0.3); font-size: 1.2rem; }
      
      /* Dark mode adjustments for ranks */
      body.theme-dark .member-row.rank-1 td { background: linear-gradient(90deg, rgba(255, 215, 0, 0.05) 0%, var(--bg-card) 100%); border-color: rgba(255, 215, 0, 0.3); }
      body.theme-dark .member-row.rank-2 td { background: linear-gradient(90deg, rgba(255, 255, 255, 0.05) 0%, var(--bg-card) 100%); border-color: rgba(255, 255, 255, 0.3); }
      body.theme-dark .member-row.rank-3 td { background: linear-gradient(90deg, rgba(205, 127, 50, 0.05) 0%, var(--bg-card) 100%); border-color: rgba(205, 127, 50, 0.3); }
      body.theme-dark .rank-cell { color: #fff; }

      /* User Cell */
      .user-cell { display: flex; align-items: center; gap: 1rem; }
      .user-avatar { 
          width: 48px; height: 48px; border-radius: 14px; display: flex; align-items: center; justify-content: center; 
          font-weight: 800; font-size: 1.2rem; box-shadow: var(--shadow-soft); position: relative;
      }
      .user-info { display: flex; flex-direction: column; gap: 0.1rem; }
      .username-text { font-weight: 700; font-size: 1.05rem; color: var(--text-main); }
      .user-role { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }

      /* Stat Badges */
      .stat-badge {
        display: inline-flex; align-items: center; gap: 0.8rem; padding: 0.6rem 1.2rem; border-radius: 12px; font-weight: 700; font-size: 0.95rem; min-width: 120px;
        transition: transform 0.2s;
      }
      .stat-badge:hover { transform: scale(1.05); }
      
      .stat-xp { 
          background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(139, 92, 246, 0.05)); 
          color: #8b5cf6; 
          border: 1px solid rgba(139, 92, 246, 0.2);
      }
      .stat-fire { 
          background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(245, 158, 11, 0.05)); 
          color: #f59e0b; 
          border: 1px solid rgba(245, 158, 11, 0.2);
      }
      .stat-decks { 
          background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(59, 130, 246, 0.05)); 
          color: #3b82f6; 
          border: 1px solid rgba(59, 130, 246, 0.2);
      }
      
      .stat-icon { font-size: 1.2rem; }
      .stat-value { font-weight: 800; display: flex; flex-direction: column; line-height: 1; font-size: 1.1rem; }
      .stat-sub { font-size: 0.7rem; opacity: 0.8; font-weight: 600; text-transform: uppercase; margin-top: 2px; }
      
      /* Action Buttons */
      .remove-btn {
        background: transparent; color: var(--text-muted); border: none; width: 36px; height: 36px; border-radius: 50%;
        cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
      }
      .remove-btn:hover { background: var(--danger-bg); color: var(--danger); transform: rotate(90deg); }
      
      body.theme-dark .remove-btn { color: var(--text-muted); }
      body.theme-dark .remove-btn:hover { color: var(--danger); }

      /* Mobile Adjustments */
      @media(max-width: 600px) {
        .custom-table thead { display: none; }
        .custom-table { border-spacing: 0 1rem; }
        .custom-table tr.member-row { 
            display: flex; flex-direction: column; gap: 0; 
            margin-bottom: 0; box-shadow: var(--shadow-soft); border-radius: 16px; overflow: hidden;
        }
        .custom-table td { 
            display: flex; justify-content: space-between; align-items: center; 
            padding: 1rem 1.5rem; border: none; border-bottom: 1px solid var(--border-color);
            border-radius: 0 !important; /* Reset radius from desktop styles */
        }
        .custom-table td:last-child { border-bottom: none; }
        
        .custom-table td::before { content: attr(data-label); font-weight: 700; color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; }
        
        .user-cell { width: 100%; justify-content: flex-end; }
        .custom-table td[data-label^="Nom"] .user-cell, .custom-table td[data-label="Username"] .user-cell { justify-content: flex-start; }
        .custom-table td[data-label^="Nom"]::before, .custom-table td[data-label="Username"]::before { display: none; }
        
        /* Rank centering on mobile */
        .custom-table td:first-child { justify-content: center; background: rgba(0,0,0,0.02); }
      }
    </style>
    <script>
      (function() {
        let theme = localStorage.getItem("theme");
        if (!theme) {
             theme = "theme-light";
        }
        document.documentElement.className = theme;
        document.body.classList.add(theme);
      })();

      function copyInviteCode() {
          const code = document.getElementById('inviteCode').innerText;
          navigator.clipboard.writeText(code).then(() => {
              const label = document.getElementById('copyLabel');
              label.innerText = '{{ t('messages.copied') }}';
              setTimeout(() => { label.innerText = '{{ t('messages.click_to_copy') }}'; }, 2000);
          });
      }
    </script>
</head>
<body class="{{ auth.user?.theme || 'theme-light' }}">
    @include('components/header')

    <div class="main-content">
        <a href="{{ route('groups.index') }}" class="back-link">
            <span>&larr;</span> {{ t('messages.back_home') }}
        </a>
        
        <!-- Header / Hero -->
        <div class="group-header">
            <div class="group-info">
                <h1>{{ group.name }}</h1>
                <p>{{ group.description || t('messages.no_description') }}</p>
                
                @if(!isTeacher)
                <div style="margin-top: 1.5rem;">
                    <div class="teacher-badge">
                        <span>👨‍🏫 {{ t('messages.teacher') }}:</span>
                        <span style="font-weight: 800;">{{ group.teacher.username }}</span>
                    </div>
                </div>
                @endif
            </div>

            @if(isTeacher)
            <div class="invite-card" onclick="copyInviteCode()">
                <div class="invite-label">{{ t('messages.invite_code') }}</div>
                <div class="invite-code" id="inviteCode">{{ group.inviteCode }}</div>
                <div class="click-to-copy" id="copyLabel">{{ t('messages.click_to_copy') }}</div>
            </div>
            @endif
        </div>

        <!-- NEW DASHBOARD LAYOUT -->
        <div class="dashboard-layout">
            
            <!-- LEFT MAIN CONTENT -->
            <div class="dashboard-main">
                
                <!-- LEADERBOARD PODIUM -->
                @if(members && members.length > 0)
                <div class="table-title" style="margin-bottom: 2rem; justify-content: center;">
                    <span>🏆 {{ t('messages.leaderboard') }} ({{ t('messages.xp_key') }})</span>
                </div>
                
                <div class="podium-section">
                    <!-- 2nd Place -->
                    @if(members.length >= 2)
                    <div class="podium-step step-2">
                        <div class="podium-avatar">
                        {{ members[1].username.charAt(0).toUpperCase() }}
                        </div>
                        <div class="podium-name">{{ members[1].username }}</div>
                        <div class="podium-score">{{ members[1].stats?.xp || 0 }} {{ t('messages.xp_key') }}</div>
                        <div class="podium-block">2</div>
                    </div>
                    @endif
                    
                    <!-- 1st Place -->
                    @if(members.length >= 1)
                    <div class="podium-step step-1">
                        <div class="podium-avatar">
                            {{ members[0].username.charAt(0).toUpperCase() }}
                        </div>
                        <div class="podium-name">{{ members[0].username }}</div>
                        <div class="podium-score">{{ members[0].stats?.xp || 0 }} {{ t('messages.xp_key') }}</div>
                        <div class="podium-block">1</div>
                    </div>
                    @endif
                    
                    <!-- 3rd Place -->
                    @if(members.length >= 3)
                    <div class="podium-step step-3">
                        <div class="podium-avatar">
                            {{ members[2].username.charAt(0).toUpperCase() }}
                        </div>
                        <div class="podium-name">{{ members[2].username }}</div>
                        <div class="podium-score">{{ members[2].stats?.xp || 0 }} {{ t('messages.xp_key') }}</div>
                        <div class="podium-block">3</div>
                    </div>
                    @endif
                </div>
                @endif

                <!-- GROUP DECKS (CLASSROOM LIBRARY) -->
                <div class="members-section" style="margin-bottom: 2rem;">
                    <div class="table-header" style="margin-bottom: 1.5rem;">
                        <div class="table-title">
                            <span>📚 {{ t('messages.group_decks_title') }}</span>
                            <span class="member-count" style="background: var(--info);">{{ group.decks ? group.decks.length : 0 }}</span>
                        </div>
                    </div>

                    @if(group.decks && group.decks.length > 0)
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem;">
                            @each(deck in group.decks)
                            <div style="background: var(--bg-body); border: 1px solid var(--border-color); border-radius: 12px; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; transition: transform 0.2s; position: relative;" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
                                <div style="font-weight: 700; font-size: 1.1rem; color: var(--text-main);">
                                    <a href="{{ route('decks.show', { id: deck.id }) }}" style="text-decoration: none; color: inherit;">
                                        {{ deck.title }}
                                    </a>
                                </div>
                                <div style="font-size: 0.9rem; color: var(--text-muted); display: flex; align-items: center; gap: 0.5rem;">
                                    <span>🃏 {{ deck.$extras.cards_count || 0 }} {{ t('messages.cards') }}</span>
                                    <span>•</span>
                                    <span>👤 {{ deck.user.username }}</span>
                                </div>
                                
                                <div style="margin-top: 1rem; display: flex; gap: 0.5rem;">
                                    <a href="{{ route('exercise.start', { deckId: deck.id }) }}" style="flex: 1; text-align: center; text-decoration: none; background: var(--primary); color: white; padding: 0.5rem; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">
                                        {{ t('messages.study_this_deck') }}
                                    </a>
                                    
                                    @if(isTeacher)
                                    <form action="{{ route('groups.removeDeck', { id: group.id }) }}" method="POST" id="remove-deck-form-{{ deck.id }}">
                                        {{ csrfField() }}
                                        <input type="hidden" name="deck_id" value="{{ deck.id }}">
                                        <button type="button" onclick="showConfirmModal('deck', {{ deck.id }}, '{{ deck.title }}')" style="background: var(--danger-bg); color: var(--danger); border: none; padding: 0.5rem; border-radius: 8px; cursor: pointer; height: 100%;">
                                            🗑️
                                        </button>
                                    </form>
                                    @endif
                                </div>
                            </div>
                            @endeach
                        </div>
                    @else
                        <div style="text-align: center; padding: 2rem; color: var(--text-muted); font-style: italic;">
                            {{ t('messages.no_decks_in_group') }}
                        </div>
                    @endif

                    @if(isTeacher)
                    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color);">
                        <div style="font-weight: 700; color: var(--text-main); margin-bottom: 1rem;">{{ t('messages.add_deck_to_group') }}</div>
                        <form action="{{ route('groups.addDeck', { id: group.id }) }}" method="POST" style="display: flex; gap: 1rem;">
                            {{ csrfField() }}
                            <select name="deck_id" style="flex: 1; padding: 0.8rem; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-body); color: var(--text-main);">
                                <option value="" disabled selected>{{ t('messages.select_deck') }}</option>
                                <option disabled>---</option>
                                @if(teacherDecks)
                                    @each(deck in teacherDecks)
                                        <option value="{{ deck.id }}">{{ deck.title }}</option>
                                    @endeach
                                @endif
                            </select>
                            <button type="submit" style="background: var(--primary); color: white; border: none; padding: 0 1.5rem; border-radius: 8px; font-weight: 700; cursor: pointer;">
                                {{ t('messages.add_deck_btn') }}
                            </button>
                        </form>
                    </div>
                    @endif
                </div>

                <!-- Members List -->
                <div class="members-section">
                    <div class="table-header">
                        <div class="table-title">
                            <span>{{ t('messages.student_progress') }}</span>
                        </div>
                    </div>
                    
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 50px;">{{ t('messages.rank') }}</th>
                                <th width="30%">{{ t('messages.username') }}</th>
                                <th>{{ t('messages.xp_key') }} / {{ t('messages.level_short') }}</th>
                                <th>{{ t('messages.streak') }}</th>
                                <th>{{ t('messages.decks_studied') }}</th>
                                @if(isTeacher)
                                <th style="text-align: right;">{{ t('messages.remove') }}</th>
                                @endif
                            </tr>
                        </thead>
                        <tbody>
                            @each((member, index) in members)
                                <tr class="member-row {{ index < 3 ? 'rank-' + (index + 1) : '' }}">
                                    <td>
                                        <div class="rank-cell {{ index < 3 ? 'rank-' + (index + 1) : '' }}">
                                            @if(index === 0)
                                                🥇
                                            @elseif(index === 1)
                                                🥈
                                            @elseif(index === 2)
                                                🥉
                                            @else
                                                #{{ index + 1 }}
                                            @endif
                                        </div>
                                    </td>
                                    <td data-label="{{ t('messages.username') }}">
                                        <div class="user-cell">
                                            <!-- Dynamic Avatar Color based on Name -->
                                            <div class="user-avatar" style="background: hsl({{ (member.username.length * 45) % 360 }}, 85%, 90%); color: hsl({{ (member.username.length * 45) % 360 }}, 70%, 40%);">
                                                {{ member.username.charAt(0).toUpperCase() }}
                                            </div>
                                            <div class="user-info">
                                                <span class="username-text">{{ member.username }}</span>
                                                <span class="user-role">{{ t('messages.members') }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="{{ t('messages.xp_key') }}">
                                        <div class="stat-badge stat-xp">
                                            <span class="stat-icon">⚡</span>
                                            <div class="stat-value">
                                                {{ member.stats?.xp || 0 }}
                                                <span class="stat-sub">{{ t('messages.level_short') }} {{ member.stats?.level || 1 }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="{{ t('messages.streak') }}">
                                        <div class="stat-badge stat-fire">
                                            <span class="stat-icon">🔥</span>
                                            <div class="stat-value">
                                                {{ member.stats?.current_streak || 0 }}
                                                <span class="stat-sub">{{ t('messages.streak') }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td data-label="{{ t('messages.decks_studied') }}">
                                        <div class="stat-badge stat-decks">
                                            <span class="stat-icon">📚</span>
                                            <div class="stat-value">
                                                {{ member.stats?.decks_studied || 0 }}
                                                <span class="stat-sub">{{ t('messages.decks') }}</span>
                                            </div>
                                        </div>
                                    </td>
                                    @if(isTeacher)
                                    <td align="right" data-label="Actions" style="width: 50px;">
                                        <form action="{{ route('groups.removeMember', { id: group.id }) }}" method="POST" id="remove-member-form-{{ member.id }}" style="margin: 0;">
                                            {{ csrfField() }}
                                            <input type="hidden" name="member_id" value="{{ member.id }}">
                                            <button type="button" class="remove-btn" onclick="showConfirmModal('member', {{ member.id }}, '{{ member.username }}')" title="{{ t('messages.remove') }}">
                                                🗑️
                                            </button>
                                        </form>
                                    </td>
                                    @endif
                                </tr>
                            @endeach
                            @if(!members || members.length === 0)
                                <tr>
                                    <td colspan="6" style="padding: 4rem 1rem; text-align: center;">
                                        <div style="width: 80px; height: 80px; background: var(--bg-body); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem auto; font-size: 2.5rem; border: 2px dashed var(--border-color);">
                                            🍃
                                        </div>
                                        <div style="font-size: 1.1rem; font-weight: 600; color: var(--text-main); margin-bottom: 0.5rem;">{{ t('messages.empty_classroom') }}</div>
                                        <div style="color: var(--text-muted);">{{ t('messages.empty_classroom_desc') }}</div>
                                    </td>
                                </tr>
                            @endif
                        </tbody>
                    </table>
                </div>

            </div>
            
            <!-- RIGHT SIDEBAR (Group Stats) -->
            <div class="stats-sidebar">
                <div style="font-weight: 700; color: var(--text-muted); text-transform: uppercase; font-size: 0.9rem; letter-spacing: 1px; margin-bottom: -0.5rem;">
                   {{ t('messages.group_stats') }}
                </div>
                
                <div class="stat-card">
                    <div class="stat-card-icon">👥</div>
                    <div class="stat-card-info">
                        <span class="stat-card-value">{{ group.members ? group.members.length : 0 }}</span>
                        <span class="stat-card-label">{{ t('messages.members') }}</span>
                    </div>
                </div>
                <div class="stat-card" style="border-left: 4px solid var(--success);">
                    <div class="stat-card-icon" style="color: var(--success); background: var(--success-bg);">✅</div>
                    <div class="stat-card-info">
                        <span class="stat-card-value">{{ groupStats.totalCorrect }}</span>
                        <span class="stat-card-label">{{ t('messages.total_questions_solved') }}</span>
                    </div>
                </div>
                <div class="stat-card" style="border-left: 4px solid var(--info);">
                    <div class="stat-card-icon" style="color: var(--info); background: var(--info-bg);">📚</div>
                    <div class="stat-card-info">
                        <span class="stat-card-value">{{ groupStats.totalDecks }}</span>
                        <span class="stat-card-label">{{ t('messages.decks_studied') }}</span>
                    </div>
                </div>
                <div class="stat-card" style="border-left: 4px solid var(--warning);">
                    <div class="stat-card-icon" style="color: var(--warning); background: var(--warning-bg);">🔥</div>
                    <div class="stat-card-info">
                        <span class="stat-card-value">{{ groupStats.totalStreaks }}</span>
                        <span class="stat-card-label">{{ t('messages.total_streaks') }}</span>
                    </div>
                </div>
                <div class="stat-card" style="border-left: 4px solid #8b5cf6;">
                    <div class="stat-card-icon" style="color: #8b5cf6; background: rgba(139, 92, 246, 0.1);">⚡</div>
                    <div class="stat-card-info">
                        <span class="stat-card-value">{{ groupStats.totalXP }}</span>
                        <span class="stat-card-label">{{ t('messages.total_xp') }}</span>
                    </div>
                </div>
            </div>

        </div>
    </div>
    <!-- Custom Confirmation Modal -->
    <div id="confirm-modal" class="modal-backdrop" onclick="if(event.target === this) hideConfirmModal()">
        <div class="modal-card">
            <div class="modal-icon">⚠️</div>
            <h3 class="modal-title">{{ t('messages.confirm_action') }}</h3>
            <p class="modal-text" id="modal-text">Are you sure?</p>
            <div class="modal-actions">
                <button class="modal-btn btn-cancel" onclick="hideConfirmModal()">{{ t('messages.cancel') }}</button>
                <button class="modal-btn btn-confirm" id="modal-confirm-btn">{{ t('messages.remove') }}</button>
            </div>
        </div>
    </div>

    <style>
        .modal-backdrop {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
            z-index: 9999; display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.3s;
        }
        .modal-backdrop.visible { opacity: 1; pointer-events: auto; }
        
        .modal-card {
            background: var(--bg-card); padding: 2rem; border-radius: 20px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.2);
            text-align: center; max-width: 400px; width: 90%;
            transform: translateY(20px); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            border: 1px solid var(--border-color);
        }
        .modal-backdrop.visible .modal-card { transform: translateY(0); }
        
        .modal-icon { font-size: 3rem; margin-bottom: 1rem; }
        .modal-title { font-size: 1.5rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-main); }
        .modal-text { color: var(--text-muted); margin-bottom: 2rem; line-height: 1.5; }
        
        .modal-actions { display: flex; gap: 1rem; justify-content: center; }
        .modal-btn { padding: 0.8rem 1.5rem; border-radius: 12px; font-weight: 700; cursor: pointer; border: none; font-size: 1rem; transition: transform 0.2s; }
        .modal-btn:hover { transform: translateY(-2px); }
        .btn-cancel { background: rgba(0,0,0,0.05); color: var(--text-main); }
        .btn-confirm { background: var(--danger); color: white; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4); }
        
        body.theme-dark .btn-cancel { background: rgba(255,255,255,0.1); color: var(--text-dark); }
        body.theme-dark .modal-card { background: #1e1e24; }
    </style>

    <script>
        let currentForm = null;

        function showConfirmModal(type, id, name) {
            const modal = document.getElementById('confirm-modal');
            const text = document.getElementById('modal-text');
            const confirmBtn = document.getElementById('modal-confirm-btn');
            
            modal.classList.add('visible');
            
            if (type === 'deck') {
                text.innerText = `{{ t('messages.confirm_remove_deck_txt') }} "${name}"?`;
                currentForm = document.getElementById('remove-deck-form-' + id);
            } else if (type === 'member') {
                text.innerText = `{{ t('messages.confirm_remove_member_txt') }} "${name}"?`;
                currentForm = document.getElementById('remove-member-form-' + id);
            }
            
            confirmBtn.onclick = () => {
                if(currentForm) currentForm.submit();
            };
        }

        function hideConfirmModal() {
            document.getElementById('confirm-modal').classList.remove('visible');
            currentForm = null;
        }

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') hideConfirmModal();
        });
    </script>
</body>
</html>
