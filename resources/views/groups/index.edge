                                        <div class="group-icon">🎓</div>
                                        <div class="code-display" title="Invite Code">{{ group.inviteCode }}</div>
                                    </div>
                                    <div class="group-name">{{ group.name }}</div>
                                    <div class="group-desc">{{ group.description || t('messages.no_description') }}</div>
                                    <div class="group-footer">
