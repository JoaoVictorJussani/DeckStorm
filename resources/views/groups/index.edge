                                        <div style="color: var(--primary); font-weight:bold;">{{ t('messages.manage') }} &rarr;</div>
                                    </div>
                                </a>
                            @endeach
                             <!-- Quick Add Card -->
                             <a href="{{ route('groups.create') }}" class="group-card" style="border: 2px dashed var(--border-color); align-items: center; justify-content: center; text-align: center; background: transparent; box-shadow: none;">
                                <div style="font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem;">+</div>
                                <div style="font-weight: 600; color: var(--primary);">{{ t('messages.create_group') }}</div>
                             </a>
                        </div>
                    @else
                        <div class="empty-state">
                            <div class="empty-icon">🎓</div>
                            <div class="empty-text">{{ t('messages.no_groups_created') }}</div>
                            <a href="{{ route('groups.create') }}" style="color: var(--primary); font-weight: bold; margin-top: 1rem; display: inline-block;">{{ t('messages.start_first_class') }} &rarr;</a>
                        </div>
