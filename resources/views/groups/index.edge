                            <span class="input-icon">#</span>
                            <input type="text" name="code" class="input-field" placeholder="{{ t('messages.enter_invite_code') }}" required maxlength="8" style="text-transform: uppercase;">
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <span>🚀</span> {{ t('messages.join_group') }}
                        </button>
                    </form>
                </div>

                <!-- Feature Highlight (Sidebar) -->
                <div class="join-card" style="background: linear-gradient(135deg, var(--primary), var(--primary-hover)); color: white;">
                    <div class="join-title" style="color: white;">⚡ {{ t('messages.did_you_know') }}</div>
                    <div class="join-desc" style="color: rgba(255,255,255,0.9);">
                       {{ t('messages.feature_tip_desc') }}
                    </div>
                    <div style="background: rgba(255,255,255,0.2); border-radius: 8px; padding: 0.8rem; font-size: 0.9rem; margin-top: 1rem;">
                        <strong>{{ t('messages.pro_tip_label') }}</strong> {{ t('messages.pro_tip_content') }}
                    </div>
                </div>

            </div>

            <!-- Main Content -->
            <div style="display: flex; flex-direction: column; gap: 3rem;">
                
                <!-- Teaching Section -->
                <div>
                    <div class="section-title">
                        <span>📚 {{ t('messages.my_groups_teaching') }}</span>
                        <span class="section-badge">{{ createdGroups ? createdGroups.length : 0 }}</span>
                    </div>

                    @if(createdGroups && createdGroups.length > 0)
                        <div class="groups-list">
                            @each(group in createdGroups)
                                <a href="{{ route('groups.show', { id: group.id }) }}" class="group-card">
