            </div>
            <div style="background: var(--bg-card); padding: 1.5rem; border-radius: 16px; border: 1px solid var(--border-color); display: flex; align-items: center; gap: 1rem; box-shadow: var(--shadow-soft);">
                <div style="width: 50px; height: 50px; background: rgba(245, 158, 11, 0.1); color: #f59e0b; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.5rem;">🎓</div>
                <div>
                    <div style="font-size: 1.5rem; font-weight: 800; color: var(--text-main);">{{ joinedGroups ? joinedGroups.length : 0 }}</div>
                    <div style="color: var(--text-muted); font-size: 0.9rem;">{{ t('messages.groups_joined_stat') }}</div>
                </div>
            </div>
        </div>

        <div class="dashboard-grid">
            <!-- Sidebar / Actions -->
            <div style="display: flex; flex-direction: column; gap: 2rem;">
                <!-- Join Card -->
                <div class="join-card">
                    <div class="join-title">👋 {{ t('messages.join_group') }}</div>
                    <div class="join-desc">{{ t('messages.join_group_desc') }}</div>
                    <form action="{{ route('groups.join') }}" method="POST" class="join-form">
                        {{ csrfField() }}
