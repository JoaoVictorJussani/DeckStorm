<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rapport - {{ deck.title }}</title>
  <link rel="shortcut icon" href="/images/icone.ico" type="image/x-icon">
  <script>
    (function() {
      let theme = localStorage.getItem('theme');
      if (!theme) theme = 'theme-light';
      document.documentElement.className = theme;
      document.addEventListener('DOMContentLoaded', function() {
        document.body.className = theme;
      });
    })();
  </script>
  <style>
    :root {
      /* Palette Clean (Slate/Zinc) */
      --primary: #3b82f6; 
      --primary-dark: #2563eb;
      
      --bg-body: #f8fafc;
      --bg-card: #ffffff;
      
      --text-main: #0f172a;
      --text-muted: #64748b;
      
      --border: #e2e8f0;
      
      --success: #22c55e;
      --danger: #ef4444;
      --warning: #f59e0b;
    }

    .theme-dark {
      --primary: #60a5fa;
      --primary-dark: #3b82f6;
      
      --bg-body: #0f172a;
      --bg-card: #1e293b;
      
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      
      --border: #334155;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-body);
      color: var(--text-main);
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding-top: 70px;
      transition: background-color 0.2s, color 0.2s;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      padding: 2rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* Header Section */
    .report-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }
    .report-title h1 {
      font-size: 2rem;
      font-weight: 800;
      margin-bottom: 0.5rem;
    }
    .report-title p {
      color: var(--text-muted);
      font-size: 1rem;
    }
    .header-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.2s;
      text-decoration: none;
    }
    .btn-outline {
      background: transparent;
      border-color: var(--border);
      color: var(--text-main);
    }
    .btn-outline:hover { background: rgba(0,0,0,0.05); }
    .theme-dark .btn-outline:hover { background: rgba(255,255,255,0.05); }

    .btn-success { background: var(--success); color: white; }
    .btn-success:hover { filter: brightness(1.1); }

    .btn-primary { background: var(--primary); color: white; }
    .btn-primary:hover { filter: brightness(1.1); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; filter: none; }

    /* Summary Cards */
    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
    }
    .summary-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .summary-label { color: var(--text-muted); font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; }
    .summary-value { font-size: 2rem; font-weight: 800; color: var(--text-main); }
    .summary-sub { font-size: 0.85rem; color: var(--text-muted); }

    /* Results List */
    .results-section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
    }
    .tool-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    .checkbox-label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
      font-weight: 500;
      color: var(--text-main);
    }

    .report-card {
      border: 1px solid var(--border);
      border-radius: 8px;
      margin-bottom: 1rem;
      overflow: hidden;
      transition: box-shadow 0.2s;
    }
    .report-card:hover { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }

    .report-main {
      padding: 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-card);
      cursor: pointer;
    }
    .user-block {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .user-avatar {
      width: 40px; height: 40px;
      background: var(--bg-body);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      border: 1px solid var(--border);
    }
    .user-name { font-weight: 600; font-size: 1.1rem; }
    .user-date { font-size: 0.85rem; color: var(--text-muted); }

    .score-block {
      display: flex;
      gap: 1.5rem;
      align-items: center;
    }
    .score-badge {
      padding: 4px 12px;
      border-radius: 20px;
      font-weight: 600;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .score-green { background: rgba(34, 197, 94, 0.1); color: var(--success); }
    .score-red { background: rgba(239, 68, 68, 0.1); color: var(--danger); }
    .chevron { transition: transform 0.2s; color: var(--text-muted); }
    .active .chevron { transform: rotate(180deg); }

    .report-details {
      display: none;
      background: var(--bg-body);
      border-top: 1px solid var(--border);
      padding: 1rem;
    }
    .active .report-details { display: block; }
    
    .detail-item {
      display: flex;
      justify-content: space-between;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--border);
      font-size: 0.95rem;
    }
    .detail-item:last-child { border-bottom: none; }
    
    /* Modal */
    .modal-overlay {
      display: none;
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);
      z-index: 1000; align-items: center; justify-content: center;
    }
    .modal-overlay.open { display: flex; }
    .modal-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
      width: 90%; max-width: 500px;
      position: relative;
    }
    .modal-close {
      position: absolute; top: 1rem; right: 1rem;
      border: none; background: none; font-size: 1.5rem; color: var(--text-muted);
      cursor: pointer;
    }
    .stat-row {
      display: flex; justify-content: space-between;
      padding: 1rem 0; border-bottom: 1px solid var(--border);
    }
    .stat-val { font-weight: 700; font-size: 1.2rem; }
    
  </style>
</head>
<body>
  @include('components/header')

  <div class="container">
    <div class="report-header">
      <div class="report-title">
        <h1>Rapport de Session</h1>
        <p>Deck: <strong>{{ deck.title }}</strong></p>
      </div>
      <div class="header-actions">
        <a href="{{ route('decks.show', { id: deck.id }) }}" class="btn btn-outline">← Retour</a>
        <a href="{{ route('decks.report.export', { id: deck.id }) }}" class="btn btn-success">
           📥 Exporter Excel
        </a>
      </div>
    </div>

    <!-- Summary Dashboard -->
    <div class="summary-grid">
      <div class="summary-card">
        <div class="summary-label">Total Sessions</div>
        <div class="summary-value">{{ reportByUser.length }}</div>
        <div class="summary-sub">Tentatives enregistrées</div>
      </div>
      <!-- You could calculate global stats server side or JS, placeholder for now -->
      <div class="summary-card">
         <div class="summary-label">Étudiants</div>
         <div class="summary-value">{{ new Set(reportByUser.map(r => r.user.id)).size }}</div>
         <div class="summary-sub">Utilisateurs uniques</div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="results-section">
      <div class="tool-bar">
        <label class="checkbox-label">
          <input type="checkbox" id="selectAll" style="transform: scale(1.2);">
          Tout sélectionner
        </label>
        <button id="btnCalcAvg" class="btn btn-primary" disabled>
          Calculer Moyenne Groupe
        </button>
      </div>

      @if(reportByUser.length === 0)
        <div style="text-align:center; padding: 3rem; color: var(--text-muted);">
          Aucune donnée disponible pour ce deck.
        </div>
      @else
        <div id="reportsList">
          @each(report in reportByUser)
            <div class="report-card" data-correct="{{ report.correctCount }}" data-wrong="{{ report.wrongCount }}" data-user="{{ report.user.username }}">
              <div class="report-main" onclick="toggleDetails(this)">
                <div class="user-block">
                  <input type="checkbox" class="card-checkbox" onclick="event.stopPropagation()">
                  <div class="user-avatar">{{ report.user.username.charAt(0).toUpperCase() }}</div>
                  <div>
                    <div class="user-name">{{ report.user.username }}</div>
                    <div class="user-date">{{ report.date.toFormat('dd MMM yyyy, HH:mm') }}</div>
                  </div>
                </div>
                <div class="score-block">
                  <div class="score-badge score-green">✔ {{ report.correctCount }}</div>
                  <div class="score-badge score-red">✘ {{ report.wrongCount }}</div>
                  <span class="chevron">▼</span>
                </div>
              </div>
              <div class="report-details">
                <h4 style="margin-bottom:1rem; color:var(--text-muted);">Détail des réponses</h4>
                @each(attempt in report.attempts)
                  <div class="detail-item">
                     <span style="flex:1;">{{ attempt.card ? attempt.card.question : 'Carte supprimée' }}</span>
                     <span style="font-weight:bold; color: {{ attempt.isCorrect ? 'var(--success)' : 'var(--danger)' }}">
                       {{ attempt.isCorrect ? 'Correct' : 'Incorrect' }}
                     </span>
                  </div>
                @endeach
              </div>
            </div>
          @endeach
        </div>
      @endif
    </div>
  </div>

  <!-- Modal -->
  <div class="modal-overlay" id="avgModal">
    <div class="modal-card">
      <button class="modal-close" onclick="closeModal()">×</button>
      <h2 style="margin-bottom:1.5rem; text-align:center;">Moyenne Sélection</h2>
      
      <div class="stat-row">
        <span>Étudiants sélectionnés</span>
        <span class="stat-val" id="modCount">0</span>
      </div>
      <div class="stat-row">
        <span>Moyenne Réponses Correctes</span>
        <span class="stat-val" style="color:var(--success)" id="modCorrect">0</span>
      </div>
      <div class="stat-row">
        <span>Moyenne Réponses Fausses</span>
        <span class="stat-val" style="color:var(--danger)" id="modWrong">0</span>
      </div>
      <div class="stat-row" style="border:none;">
        <span>Taux de réussite moyen</span>
        <span class="stat-val" style="color:var(--primary)" id="modRate">0%</span>
      </div>
      
      <div style="margin-top:1.5rem; text-align:center;">
        <button class="btn btn-outline" onclick="closeModal()">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    function toggleDetails(element) {
      element.parentElement.classList.toggle('active');
    }

    // Checkbox Logic
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.card-checkbox');
    const btnCalc = document.getElementById('btnCalcAvg');
    const modal = document.getElementById('avgModal');

    function updateBtn() {
      const count = document.querySelectorAll('.card-checkbox:checked').length;
      btnCalc.textContent = `Calculer Moyenne (${count})`;
      btnCalc.disabled = count === 0;
    }

    if(selectAll) {
      selectAll.addEventListener('change', (e) => {
        checkboxes.forEach(cb => cb.checked = e.target.checked);
        updateBtn();
      });
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateBtn);
    });

    // Calc Logic
    btnCalc.addEventListener('click', () => {
       const selected = document.querySelectorAll('.card-checkbox:checked');
       if(selected.length === 0) return;

       let totalCorrect = 0, totalWrong = 0;
       selected.forEach(cb => {
         const card = cb.closest('.report-card');
         totalCorrect += parseInt(card.dataset.correct);
         totalWrong += parseInt(card.dataset.wrong);
       });

       const count = selected.length;
       const avgCorrect = (totalCorrect / count).toFixed(1);
       const avgWrong = (totalWrong / count).toFixed(1);
       const totalQs = totalCorrect + totalWrong; 
       // Careful: totalQs is sum of all attempts. Average Qs per student = totalQs / count
       // Rate = (Total Correct / Total Attempts) * 100
       const rate = totalQs > 0 ? Math.round((totalCorrect / totalQs) * 100) : 0;

       document.getElementById('modCount').textContent = count;
       document.getElementById('modCorrect').textContent = avgCorrect;
       document.getElementById('modWrong').textContent = avgWrong;
       document.getElementById('modRate').textContent = rate + '%';

       modal.classList.add('open');
    });

    function closeModal() {
      modal.classList.remove('open');
    }
    
    // Outside click
    modal.addEventListener('click', (e) => {
      if(e.target === modal) closeModal();
    });

  </script>
</body>
</html>
