<!-- Modal de convite (exemplo, pode ser ativado via JS) -->
<div id="invite-modal" class="invite-modal">
  <div class="invite-modal-content">
    <button
      class="invite-modal-close"
      onclick="document.getElementById('invite-modal').classList.remove('active')"
    >×</button>
    <div id="invite-modal-message">
      Você foi convidado para um deck restrito!
    </div>
    <form id="invite-accept-form" method="POST" style="margin-top:1.5rem;">
      {{ csrfField() }}
      <button type="submit" class="invite-btn">Accepter</button>
    </form>
    <form id="invite-refuse-form" method="POST" style="margin-top:0.5rem;">
      {{ csrfField() }}
      <button type="submit" class="invite-btn refuse">Refuser</button>
    </form>
  </div>
</div>

<script>
  function headerToggleDropdown() {
    document.getElementById("header-userDropdown").classList.toggle("open");
  }

  function toggleLangDropdown() {
    document.getElementById("header-langDropdown").classList.toggle("open");
  }

  function changeLang(lang) {
      // Store preference
      localStorage.setItem('deckstorm_lang', lang);
      
      // Update URL with new lang param while preserving others (like 'q')
      const url = new URL(window.location.href);
      url.searchParams.set('lang', lang);
      window.location.href = url.toString();
      
      return false; // Prevent default link behavior
  }

  // Update flag on load based on localStorage (visual only, real change requires backend)
  document.addEventListener("DOMContentLoaded", () => {
       // Logic handled by server-side translation of 'language.current'
  });
  
  document.addEventListener("click", function(event) {
     const mobileMenu = document.getElementById("mobileMenu");
     const hamburger = document.querySelector(".hamburger-btn");
     const overlay = document.querySelector(".mobile-menu-overlay");
     
     // Close mobile menu if swipe or click outside (handled by overlay click actually)
     
     const dropdown = document.getElementById("header-userDropdown");
    if (dropdown && !dropdown.contains(event.target)) {
      dropdown.classList.remove("open");
    }

    const langDropdown = document.getElementById("header-langDropdown");
    if (langDropdown && !langDropdown.contains(event.target)) {
      langDropdown.classList.remove("open");
    }

    // Fermer dropdown de notifications si clic en dehors (mais PAS si clic sur la cloche ou le menu)
    const notifDropdown = document.getElementById("notif-dropdown");
    const notifBell = document.getElementById("notif-bell");
    if (notifDropdown && notifDropdown.style.display === "block" && !notifDropdown.contains(event.target) && event.target !== notifBell) {
      notifDropdown.style.display = "none";
    }
  });

  // Fonction de recherche dynamique
  
  function toggleMobileMenu() {
    document.getElementById("mobileMenu").classList.add("open");
    document.querySelector(".mobile-menu-overlay").classList.add("open");
  }
  
  function closeMobileMenu() {
    document.getElementById("mobileMenu").classList.remove("open");
    document.querySelector(".mobile-menu-overlay").classList.remove("open");
  }

  function headerSearchDecks(event) {
    // Handle both desktop and mobile inputs
    const target = event.target;
    const query = target.value.trim();
    if (event.key === "Enter" && query.length > 0) {
      window.location.href = "/deck/search?q=" + encodeURIComponent(query);
    }
  }

  // Theme switch logic
  
  function setTheme(theme) {
    document.body.classList.remove("theme-light", "theme-dark");
    document.body.classList.add(theme);
    localStorage.setItem("theme", theme);
    
    // Update all theme switches (desktop & mobile)
    const inputs = document.querySelectorAll(".theme-switch-input");
    inputs.forEach(input => {
        input.checked = (theme === "theme-dark");
    });
  }
  
  function toggleTheme() {
    var isDark = document.body.classList.contains("theme-dark");
    var newTheme = isDark ? "theme-light" : "theme-dark";
    setTheme(newTheme);
  }
  // Inicialização do tema ao carregar
  
  document.addEventListener("DOMContentLoaded", function() {
    let theme = localStorage.getItem("theme");
    if (!theme) {
      theme = "theme-light";
    }
    setTheme(theme);
    
    // Corrige o estado do switch se o usuário navegar entre páginas
    const inputs = document.querySelectorAll(".theme-switch-input");
    inputs.forEach(input => {
      input.onchange = toggleTheme;
    });
    // Garante que o switch está correto conforme o fundo
    // (handled by setTheme above)
    // Affichage du dot selon notifications et sessionStorage
    const dot = document.getElementById("notif-dot");
    const notificationsCount = {{ notifications?.length || 0 }};
    if (dot) {
      if (notificationsCount > 0 && !sessionStorage.getItem("notifDotHidden")) {
        dot.style.display = "block";
      } else {
        dot.style.display = "none";
      }
      if (notificationsCount === 0) {
        sessionStorage.removeItem("notifDotHidden");
      }
    }
  });
  
  function colorNotifLis() {
    // Coloration des notifications jamais vues en bleu clair
    let seenIds = [];
    try {
      seenIds = JSON.parse(localStorage.getItem("seenNotifIds") || "[]");
    } catch {}
    const notifLis = document.querySelectorAll("#notif-dropdown li[data-notif-id]");
    notifLis.forEach(li => {
      const id = parseInt(li.getAttribute("data-notif-id"));
      if (!seenIds.includes(id)) {
        li.style.background = "#e3f2fd";
      } else {
        li.style.background = "#fff";
      }
    });
  }
  
  function toggleNotifDropdown() {
    const dd = document.getElementById("notif-dropdown");
    const isOpen = dd.style.display === "block";
    dd.style.display = isOpen ? "none" : "block";
    if (!isOpen) {
      // Affiche le menu, applique la coloration
      colorNotifLis();
      // Retire le point rouge après ouverture et marque comme "vu" dans sessionStorage
      const dot = document.getElementById("notif-dot");
      if (dot) {
        dot.style.display = "none";
        sessionStorage.setItem("notifDotHidden", "1");
      }
      // Marquer toutes les notifications affichées comme "vues" dans localStorage
      const notifLis = dd.querySelectorAll("li[data-notif-id]");
      let seenIds = JSON.parse(localStorage.getItem("seenNotifIds") || "[]");
      notifLis.forEach(li => {
        const id = parseInt(li.getAttribute("data-notif-id"));
        if (!seenIds.includes(id)) seenIds.push(id);
      });
      localStorage.setItem("seenNotifIds", JSON.stringify(seenIds));
      // Mettre à jour le fond des notifications
      notifLis.forEach(li => {
        li.style.background = "#fff";
      });
    }
  }
</script>
