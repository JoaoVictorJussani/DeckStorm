<style>
  /* Styles globaux */
  
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  }
  
  /* Style du corps */
  
  body {
    background: #fff;
    color: #222;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100vh;
    font-size: 1rem;
  }
  
  body.theme-light {
    background: #fff;
    color: #222;
  }
  
  body.theme-dark {
    background: #0a0c10;
    color: #e6e9ef;
  }
  
  /* Barre de navigation */
  
  .header-navbar {
    backdrop-filter: blur(8px);
    background: var(--header-bg, rgba(255,255,255,0.95));
    box-shadow: 0 2px 15px rgba(25, 118, 210, 0.10);
    height: calc(70px + env(safe-area-inset-top));
    width: 100%;
    padding: env(safe-area-inset-top) max(2rem, env(safe-area-inset-right)) 0 max(2rem, env(safe-area-inset-left));
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid var(--primary, #1976d2);
    color: var(--header-color, #222);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
  }
  
  .header-navbar h2 {
    font-size: 1.8rem;
    font-weight: 700;
  }
  
  .header-navbar button {
    color: var(--header-color, #222);
    padding: 0.7rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.3s ease;
  }
  
  .header-navbar a {
    text-decoration: none;
    color: var(--primary, #1976d2);
    font-size: 1.5rem;
    font-weight: bold;
  }
  
  .header-navbar img {
    height: 36px;
    width: 36px;
    margin-right: 0.7rem;
    vertical-align: middle;
  }
  
  /* Dropdown styles */
  
  .header-dropdown {
    position: relative;
    display: inline-block;
  }
  
  .header-dropdown-toggle {
    background: transparent;
    color: var(--header-color, #222);
    border: none;
    box-shadow: none;
    padding: 0.5rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s, color 0.2s;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .header-dropdown-toggle:hover,
  .header-dropdown-toggle:focus {
    color: var(--primary, #1976d2);
    outline: none;
  }
  
  body.theme-dark .header-dropdown-toggle:hover,
  body.theme-dark .header-dropdown-toggle:focus {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  
  .header-dropdown-menu {
    display: none;
    position: absolute;
    right: 0;
    backdrop-filter: blur(10px);
    background: var(--dropdown-bg, rgba(255,255,255,0.98));
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid var(--dropdown-border, rgba(25, 118, 210, 0.18));
    border-radius: 8px;
    z-index: 100;
    margin-top: 0.5rem;
    padding: 0.5rem 0;
  }
  
  .header-dropdown.open .header-dropdown-menu {
    display: block;
  }
  
  .header-dropdown-menu a,
  .header-dropdown-menu button {
    display: block;
    width: 100%;
    background: none;
    border: none;
    color: var(--primary, #1976d2);
    text-align: left;
    padding: 0.7rem 1.2rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border-radius: 6px;
    transition: background 0.2s, color 0.2s;
    text-decoration: none;
  }
  
  .header-dropdown-menu a:hover,
  .header-dropdown-menu button:hover {
    background: var(--primary, #1976d2);
    color: #fff;
  }
  
  .header-logout-btn {
    color: #ff4d4d;
  }
  
  .header-logout-btn:hover {
    background: #ff4d4d !important;
    color: #fff;
  }

  .dropdown-arrow {
    font-size: 0.75rem;
    opacity: 0.7;
    margin-top: 2px; /* Visual alignment */
  }
  

  
  .header-username {
    font-weight: 400 !important;
    font-size: 1rem;
  }

  /* Search bar styles */
  
  .header-search {
    flex: 1;
    max-width: 500px;
    margin: 0 2rem;
    position: relative;
  }
  
  .header-search input {
    width: 100%;
    padding: 0.6rem 1rem;
    font-size: 1rem;
    border: 1.5px solid var(--search-border, rgba(25, 118, 210, 0.25));
    border-radius: 8px;
    background: var(--search-bg, rgba(245, 245, 245, 0.85));
    color: var(--input-color, #222);
    transition: border 0.2s, box-shadow 0.2s;
    backdrop-filter: blur(4px);
  }
  
  .header-search input:focus {
    outline: none;
    border-color: var(--primary, #1976d2);
    box-shadow: 0 0 8px var(--primary, #1976d2);
  }
  
  .header-search input::placeholder {
    color: #888;
    opacity: 1;
  }
  
  /* Theme switch styles */
  
  .theme-switch {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-right: 1rem;
    user-select: none;
  }
  
  .theme-switch-label {
    font-size: 1.1rem;
    color: var(--primary, #1976d2);
    cursor: pointer;
    font-weight: 500;
  }
  
  .theme-switch-slider {
    width: 44px;
    height: 24px;
    background: var(--primary, #1976d2);
    border-radius: 12px;
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
    display: inline-block;
    border: 1px solid #222;
  }
  
  .theme-switch-slider:before {
    content: '';
    position: absolute;
    left: 2px;
    top: 2px;
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.10);
  }
  
  .theme-switch-input:checked + .theme-switch-slider {
    background: #222;
  }
  
  .theme-switch-input:checked + .theme-switch-slider:before {
    transform: translateX(20px);
    background: #ffe600;
  }
  
  .theme-switch-input {
    display: none;
  }
  
  /* Dark theme overrides */
  
  body.theme-dark .header-navbar {
    --header-bg: rgba(10,12,16,0.95);
    --header-color: #e6e9ef;
    --primary: #1976d2;
    --primary-hover: #1565c0;
    --dropdown-bg: rgba(34,34,34,0.95);
    --dropdown-border: rgba(25, 118, 210, 0.18);
    --shadow: rgba(25, 118, 210, 0.10);
    --search-bg: rgba(17,19,23,0.85);
    --search-border: rgba(25, 118, 210, 0.25);
    --input-color: #e0e0e0;
  }
  
  body.theme-dark .header-dropdown-menu {
    --dropdown-bg: rgba(34,34,34,0.95);
    --dropdown-border: rgba(25, 118, 210, 0.18);
    --shadow: rgba(25, 118, 210, 0.10);
  }
  
  body.theme-dark .header-search input {
    --search-bg: rgba(17,19,23,0.85);
    --input-color: #e0e0e0;
    --search-border: rgba(25, 118, 210, 0.25);
  }

  body.theme-dark .theme-switch-slider {
    border-color: #fff;
  }

  /* Streak Badge */
  .streak-badge {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    border-radius: 20px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    cursor: help;
    transition: transform 0.2s;
    user-select: none;
    margin-right: 0.5rem;
  }
  .streak-badge:hover {
    transform: scale(1.05);
    background: rgba(245, 158, 11, 0.2);
  }
  .streak-badge span {
    line-height: 1;
  }
  
  body.theme-dark .streak-badge {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.3);
  }

  @media (max-width: 768px) {
    /* .header-search {
       display: none; <-- Removed as user wants it visible
    } */
    
    .header-navbar {
      padding-left: max(1rem, env(safe-area-inset-left));
      padding-right: max(1rem, env(safe-area-inset-right));
    }

    .invite-btn {
        padding: 0.5rem 0.8rem;
        font-size: 0.9rem;
    }
  }
  
  @media (max-width: 600px) {
    .header-navbar {
      padding-left: max(0.5rem, env(safe-area-inset-left));
      padding-right: max(0.5rem, env(safe-area-inset-right));
      gap: 0.5rem;
    }
    
    /* Hide text 'DeckStorm' */
    .brand-text {
      display: none; 
    }
    .header-navbar > a img {
      margin-right: 0;
    }

    /* Override inline style of the right container */
    .header-navbar > div:last-child {
      gap: 0.5rem !important;
    }

    /* Compact Theme Switch */
    .theme-switch {
      margin-right: 0;
      gap: 0;
      padding: 0;
    }
    .theme-switch span:not(.theme-switch-slider) {
      display: none;
    }

    #notif-bell {
      font-size: 1.5rem !important;
    }

    .header-dropdown-toggle {
        padding: 0.4rem 0.8rem;
    }

    /* Mobile specific adjustments for modals/popups */


    .notif-dropdown {
      position: fixed !important;
      top: 70px !important;
      left: 1rem !important;
      right: 1rem !important;
      width: auto !important;
      max-width: none !important;
    }
  }

  /* Desktop Notif Dropdown Styles */
  .notif-dropdown {
    position: absolute;
    right: 0;
    top: 40px;
    min-width: 300px;
    max-width: 400px;
    background: #fff;
    border: 1px solid #1976d2;
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(25,118,210,0.10);
    z-index: 999;
  }
  
  body.theme-dark .notif-dropdown {
      background: #1e293b;
      border-color: rgba(255,255,255,0.1);
      color: #e2e8f0;
  }
  
  body.theme-dark .notif-dropdown li {
      background: #1e293b !important;
      border-color: rgba(255,255,255,0.05) !important;
  }

  @media (max-width: 1200px) {
    .header-search {
      margin: 0 1rem;
    }
  }
  
  /* Botão de convite */
  
  .invite-btn {
    background: linear-gradient(90deg, #1976d2 60%, #1565c0 100%);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 0.6rem 1.3rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    margin-right: 0.5rem;
    box-shadow: 0 2px 8px rgba(25, 118, 210, 0.10);
    transition: background 0.2s, box-shadow 0.2s, transform 0.2s;
  }
  
  .invite-btn:hover {
    background: #1565c0;
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 4px 16px rgba(25, 118, 210, 0.18);
  }
  
  .invite-btn.refuse {
    background: #fff;
    color: #ff4d4d;
    border: 2px solid #ff4d4d;
    box-shadow: 0 2px 8px rgba(255,77,77,0.08);
  }
  
  .invite-btn.refuse:hover {
    background: #ff4d4d;
    color: #fff;
    border-color: #ff4d4d;
  }
  
  /* Modal de convite */
  
  .invite-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(25, 118, 210, 0.18);
    backdrop-filter: blur(4px);
    align-items: center;
    justify-content: center;
  }
  
  .invite-modal.active {
    display: flex;
  }
  
  .invite-modal-content {
    background: #fff;
    color: #1976d2;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(25, 118, 210, 0.18);
    padding: 2.5rem 2rem 2rem 2rem;
    max-width: 400px;
    width: 90vw;
    position: relative;
    text-align: center;
    animation: slideIn 0.3s ease;
  }
  
  body.theme-dark .invite-modal-content {
    background: #181c23;
    color: #e6e9ef;
  }
  
  .invite-modal-close {
    position: absolute;
    top: 12px;
    right: 18px;
    background: #e3f2fd;
    color: #1976d2;
    border: none;
    border-radius: 50%;
    font-size: 1.3rem;
    width: 36px;
    height: 36px;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  
  .invite-modal-close:hover {
    background: #1976d2;
    color: #fff;
  }
  
  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hamburger Menu Styles (Integrated) */
  .mobile-hamburger {
    display: none;
    font-size: 1.8rem;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  
  /* Legacy class if needed, otherwise safe to ignore */
  .hamburger-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.8rem;
    color: var(--header-color, #222);
    cursor: pointer;
    margin-right: 0.5rem;
    padding: 0.5rem;
  }

  /* Mobile Menu Container */
  .mobile-menu-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0,0,0,0.5);
    z-index: 9998;
    backdrop-filter: blur(2px);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .mobile-menu-overlay.open {
    display: block;
    opacity: 1;
  }

  .mobile-menu {
    position: fixed;
    top: 0;
    left: -100%;
    width: 85%;
    max-width: 320px;
    height: 100vh;
    background: var(--header-bg, rgba(255,255,255,0.98));
    backdrop-filter: blur(15px);
    box-shadow: 2px 0 20px rgba(0,0,0,0.1);
    z-index: 9999;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow-y: auto;
  }
  
  body.theme-dark .mobile-menu {
    background: #181c23;
    border-right: 1px solid #1976d2;
  }

  .mobile-menu.open {
    left: 0;
  }

  .close-mobile-menu {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: none;
    border: none;
    font-size: 2rem;
    color: var(--header-color, #222);
    cursor: pointer;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s;
  }
  
  body.theme-dark .close-mobile-menu {
     color: #fff;
  }

  .close-mobile-menu:hover {
    background: rgba(0,0,0,0.05);
  }

  /* Mobile Item Styles */
  .mobile-section {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 1rem;
  }
  
  body.theme-dark .mobile-section {
    border-bottom-color: rgba(255,255,255,0.05);
  }

  .mobile-section:last-child {
    border-bottom: none;
  }

  .mobile-logo {
     display: flex;
     align-items: center;
     font-size: 1.5rem;
     font-weight: bold;
     color: var(--primary, #1976d2);
     text-decoration: none;
     margin-bottom: 0.5rem;
  }
  
  .mobile-search input {
    width: 100%;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--search-border, #ddd);
    background: var(--search-bg, #f5f5f5);
    color: var(--input-color, #333);
  }

  .mobile-item-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: none;
    border: none;
    color: var(--header-color, #222);
    font-size: 1.1rem;
    font-weight: 500;
    padding: 0.8rem;
    cursor: pointer;
    border-radius: 12px;
    width: 100%;
    text-align: left;
    transition: background 0.2s;
    text-decoration: none;
  }
  
  body.theme-dark .mobile-item-btn {
    color: #e0e0e0;
  }

  .mobile-item-btn:hover {
    background: rgba(25, 118, 210, 0.08);
    color: var(--primary, #1976d2);
  }
  
  .mobile-lang-options {
    display: flex;
    gap: 0.5rem;
    padding-left: 1rem;
  }
  
  .mobile-lang-btn {
     padding: 0.5rem 1rem;
     border: 1px solid var(--primary, #1976d2);
     border-radius: 8px;
     color: var(--primary, #1976d2);
     background: transparent;
     text-decoration: none;
     font-weight: 600;
     font-size: 0.9rem;
  }
  
  .mobile-lang-btn.active {
     background: var(--primary, #1976d2);
     color: white;
  }

  @media (max-width: 900px) {
    .mobile-hamburger {
      display: inline-block;
    }
    /* Hide logo image on mobile as it is in the menu */
    .logo-trigger img {
        display: none;
    }
    
    /* Styling explicit trigger area */
    .logo-trigger {
        cursor: pointer;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        text-decoration: none;
        color: inherit; /* Ensure text color inherits */
    }
    
    .logo-trigger:active {
        background: rgba(0,0,0,0.08);
    }
    
    body.theme-dark .logo-trigger:active {
        background: rgba(255,255,255,0.1);
    }

    
    .desktop-only {
      display: none !important;
    }
    .header-navbar {
      justify-content: flex-start;
      gap: 0.5rem;
    }
    
    /* On mobile, only show hamburger and logo in the main header bar */
  }
</style>
<div class="header-navbar">
  <a href="{{ route('home') }}" class="logo-trigger" title="{{ t('messages.back_home') }}" onclick="if(window.innerWidth <= 900) { event.preventDefault(); toggleMobileMenu(); }">
    <span class="mobile-hamburger">☰</span>
    <img src="/images/icone.ico" alt="Logo DeckStorm" title="Logo DeckStorm" />
    <span class="brand-text">DeckStorm</span>
  </a>

  <!-- Desktop Search -->
  <div
    class="header-search-container desktop-only"
    style="display: flex; align-items: center; gap: 1rem; flex: 1; justify-content: center; max-width: 800px;"
  >
    <div class="header-search">
      <input
        type="text"
        id="headerSearch"
        placeholder="{{ t('messages.search_placeholder') }}"
        title="{{ t('messages.search_placeholder') }}"
        onkeyup="headerSearchDecks(event)"
      />
    </div>
  </div>

  <!-- Navbar Actions (Right) -->
  <div style="display: flex; align-items: center; gap: 1rem;">
    <!-- Streak (Fire) -->
    @if(auth.user)
      @let(userStats = await auth.user.related('stats').query().first())
      @if(userStats && userStats.current_streak > 0)
        <div class="streak-badge" title="{{ t('messages.streak_tooltip', { count: userStats.current_streak }) }}">
          <span style="font-size: 1.2rem;">🔥</span>
          <span style="font-weight: 700; color: #f59e0b; font-size: 1rem;">{{ userStats.current_streak }}</span>
        </div>
      @endif

      <!-- XP / Level Badge -->
      @if(userStats)
        @let(curLevel = userStats.level || 1)
        @let(nextThresh = 100 * curLevel * curLevel)
        @let(prevThresh = curLevel === 1 ? 0 : 100 * (curLevel - 1) * (curLevel - 1))
        @let(xpInLvl = (userStats.xp || 0) - prevThresh)
        @let(xpNeeded = nextThresh - prevThresh)
        @let(progPct = xpNeeded > 0 ? Math.round((xpInLvl / xpNeeded) * 100) : 0)
        
        <div class="streak-badge" style="background: rgba(59, 130, 246, 0.1); border-color: rgba(59, 130, 246, 0.3);" title="{{ t('messages.level_tooltip', { level: curLevel, current: xpInLvl, total: xpNeeded }) }} ({{ xpNeeded - xpInLvl }} XP -> {{ t('messages.level_short') }} {{ curLevel + 1 }})">
          <span style="font-size: 1.2rem;">⭐</span>
          <span style="font-weight: 700; color: var(--primary); font-size: 1rem;">{{ t('messages.level_short') }} {{ curLevel }}</span>
        </div>
      @endif
    @endif

    <!-- Notificações (Always visible) -->
    <div id="notif-container" style="position:relative; display: flex; align-items: center;">
      <button
        id="notif-bell"
        style="color: #1976d2; background: none; border: none; cursor: pointer; font-size: 1.8rem; padding: 0; position:relative;"
        onclick="toggleNotifDropdown()"
        title="Notifications"
      >
        🔔
        <span
          id="notif-dot"
          style="display:none;position:absolute;top:0;right:0;width:12px;height:12px;background:#ff4d4d;border-radius:50%;"
        ></span>
      </button>
      <div
        id="notif-dropdown"
        class="notif-dropdown"
        style="display:none;"
      >
        <div style="padding:1rem;">
          <b>{{ t('messages.notifications') }}</b>
          <ul style="list-style:none;padding:0;margin:0;max-height:350px;overflow-y:auto;">
            @if(notifications?.length)
              @each(n in notifications)
                <li
                  id="notif-li-{{ n.id }}"
                  data-notif-id="{{ n.id }}"
                  style="padding:0.75rem; border-bottom:1px solid #eee; background:#fff; border-radius: 8px; margin-bottom: 0.5rem;"
                >
                  <div style="font-weight: 500;">
                    {{ n.message }}
                  </div>
                  <div style="font-size:0.85em;color:#888;margin-top:4px;">
                    {{ n.created_at?.toRelative ? n.created_at.toRelative() : n.created_at }}
                  </div>
                  @if(n.type === 'invite' && n.deck_id)
                    <form action="/deck/{{ n.deck_id }}/accept-invite" method="POST" style="display:inline;">
                      {{ csrfField() }}
                      <button type="submit" class="invite-btn">Accepter</button>
                    </form>
                    <form action="/deck/{{ n.deck_id }}/refuse-invite" method="POST" style="display:inline;">
                      {{ csrfField() }}
                      <button type="submit" class="invite-btn refuse">Refuser</button>
                    </form>
                  @endif
