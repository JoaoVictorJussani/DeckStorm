<!DOCTYPE html>
<html lang="{{ i18n.locale }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>
      {{ t('deck.edit_title') }} - DeckStorm
    </title>
    <link rel="shortcut icon" href="/images/icone.ico" type="image/x-icon" />
    <script>
      (function() {
        let theme = localStorage.getItem("theme");
        if (!theme) theme = "theme-light";
        document.documentElement.className = theme;
        document.addEventListener("DOMContentLoaded", function() {
          document.body.className = theme;
        });
      })();
    </script>
    <style>
      :root {
        /* Palette Clean (Slate/Zinc) */
        --primary: #3b82f6;
        --primary-dark: #2563eb;
        --bg-body: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border: #e2e8f0;
        --danger: #ef4444;
        --warning: #f59e0b;
      }
      
      .theme-dark {
        --primary: #60a5fa;
        --primary-dark: #3b82f6;
        --bg-body: #0f172a;
        --bg-card: #1e293b;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
        --border: #334155;
      }
      
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background-color: var(--bg-body);
        color: var(--text-main);
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        padding-top: calc(90px + env(safe-area-inset-top));
        padding-bottom: max(2rem, env(safe-area-inset-bottom));
        padding-left: max(1rem, env(safe-area-inset-left));
        padding-right: max(1rem, env(safe-area-inset-right));
        transition: background-color 0.2s, color 0.2s;
      }
      
      .container {
        width: 100%;
        max-width: 700px;
        padding: 3rem 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      
      .page-header {
        text-align: center;
        margin-bottom: 0.5rem;
      }
      
      .page-title {
        font-size: 2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      
      .page-subtitle {
        color: var(--text-muted);
        font-size: 1rem;
      }
      
      .edit-form-card {
        background: var(--bg-card);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 10px 30px -10px rgba(0,0,0,0.1);
        border: 1px solid var(--border);
      }
      
      .form-group {
        margin-bottom: 1.5rem;
      }
      
      .form-label {
        display: block;
        font-weight: 600;
        font-size: 0.95rem;
        margin-bottom: 0.5rem;
        color: var(--text-main);
      }
      
      .form-helper {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.3rem;
      }
      
      .form-input,
      .form-textarea,
      .form-select {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 2px solid var(--border);
        border-radius: 10px;
        background: var(--bg-body);
        color: var(--text-main);
        font-size: 1rem;
        font-family: inherit;
      }
      
      input[type="checkbox"],
      input[type="radio"] {
        width: auto !important;
        height: auto !important;
        display: inline-block !important;
        appearance: auto !important;
        -webkit-appearance: checkbox !important;
      }
      
      input[type="radio"] {
        -webkit-appearance: radio !important;
      }
      
      .form-textarea {
        min-height: 100px;
        resize: vertical;
      }
      
      .form-input:focus,
      .form-textarea:focus,
      .form-select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        background: var(--bg-card);
      }
      
      .char-counter {
        text-align: right;
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 5px;
      }
      
      /* Checkbox Group */
      
      .checkbox-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 0.5rem;
      }
      
      .checkbox-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s;
      }
      
      .checkbox-card:hover {
        background: var(--bg-body);
        border-color: var(--primary);
      }
      
      .checkbox-card input {
        width: auto;
        transform: scale(1.3);
        cursor: pointer;
      }
      
      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 2.5rem;
      }
      
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.8rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
      }
      
      .btn-primary {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
      }
      
      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);
      }
      
      .btn-secondary {
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-muted);
      }
      
      .btn-secondary:hover {
        background: rgba(0,0,0,0.05);
        color: var(--text-main);
        border-color: var(--text-muted);
      }
      
      .theme-dark .btn-secondary:hover {
        background: rgba(255,255,255,0.05);
      }
      
      .card-icon {
        font-size: 3rem;
        text-align: center;
        margin-bottom: 1rem;
        animation: float 3s ease-in-out infinite;
      }
      
      @keyframes float {
        50% {
          transform: translateY(-10px);
        }
      }

      /* Visibility Radio Cards */
      .visibility-options {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
        margin-top: 0.5rem;
      }
      
      .visibility-card {
        position: relative;
        cursor: pointer;
      }
      
      .visibility-card input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
      }
      
      .visibility-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.25rem 1rem;
        background: var(--bg-body);
        border: 2px solid var(--border);
        border-radius: 12px;
        transition: all 0.2s;
        text-align: center;
        height: 100%;
      }
      
      .visibility-card:hover .visibility-content {
        border-color: var(--primary);
        transform: translateY(-2px);
      }
      
      .visibility-card input:checked + .visibility-content {
        background: var(--bg-card);
        border-color: var(--primary);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
      }
      
      .visibility-icon {
        font-size: 1.8rem;
        margin-bottom: 0.5rem;
      }
      
      .visibility-label {
        font-weight: 700;
        font-size: 1rem;
        color: var(--text-main);
        display: block;
      }
      
      .visibility-desc {
        font-size: 0.8rem;
        color: var(--text-muted);
        margin-top: 6px;
        line-height: 1.3;
      }
    </style>
  </head>
  <body>
    @include('components/header')

    <div class="container">
      <div class="page-header">
        <div class="card-icon">
          ⚙️
        </div>
        <h1 class="page-title">
          {{ t('deck.edit_title') }}
        </h1>
        <p class="page-subtitle">
          {{ t('deck.config_subtitle') }}
        </p>
      </div>

      <form class="edit-form-card" action="{{ route('decks.update', { id: deck.id }) }}" method="POST">
        {{ csrfField() }}
        <!-- Titre -->
        <div class="form-group">
          <label class="form-label" for="title">{{ t('deck.title_label') }}</label>
          <input
            class="form-input"
            type="text"
            id="title"
            name="title"
            value="{{ deck.title }}"
            required
            placeholder="Mon super deck"
          />
        </div>

        <!-- Description -->
        <div class="form-group">
          <label class="form-label" for="description">{{ t('deck.description_label') }}</label>
          <textarea
            class="form-textarea"
            id="description"
            name="description"
            maxlength="125"
            required
            placeholder="Description courte (125 car. max)"
          >{{ deck.description }}</textarea>
          <div class="char-counter">
            <span id="charCount">0</span>/125
          </div>
        </div>

        <!-- Visibilité -->
        <div class="form-group">
          <label class="form-label">{{ t('deck.visibility_label') }}</label>
          <div class="visibility-options">
            <label class="visibility-card">
              <input type="radio" name="visibility" value="private" {{ deck.visibility === 'private' ? 'checked' : '' }} required>
              <div class="visibility-content">
                <span class="visibility-icon">🔒</span>
                <span class="visibility-label">{{ t('deck.private') }}</span>
                <span class="visibility-desc">{{ t('deck.private_desc', {}, i18n.locale === 'fr' ? 'Uniquement pour vous' : (i18n.locale === 'pt-br' ? 'Apenas para você' : 'Only for you')) }}</span>
              </div>
            </label>
            <label class="visibility-card">
              <input type="radio" name="visibility" value="public" {{ deck.visibility === 'public' ? 'checked' : '' }}>
              <div class="visibility-content">
                <span class="visibility-icon">🌍</span>
                <span class="visibility-label">{{ t('deck.public') }}</span>
                <span class="visibility-desc">{{ t('deck.public_desc', {}, i18n.locale === 'fr' ? 'Visible par tous' : (i18n.locale === 'pt-br' ? 'Visível para todos' : 'Visible to everyone')) }}</span>
              </div>
            </label>
            <label class="visibility-card">
              <input type="radio" name="visibility" value="restricted" {{ deck.visibility === 'restricted' ? 'checked' : '' }}>
              <div class="visibility-content">
                <span class="visibility-icon">🔐</span>
                <span class="visibility-label">{{ t('deck.restricted') }}</span>
                <span class="visibility-desc">{{ t('deck.restricted_desc', {}, i18n.locale === 'fr' ? 'Accès par invitation' : (i18n.locale === 'pt-br' ? 'Acesso por convite' : 'Access by invitation')) }}</span>
              </div>
            </label>
          </div>
          <div class="form-helper">
            {{ t('deck.visibility_help') }}
          </div>
        </div>

        <!-- Modes -->
        <div class="form-group">
          <label class="form-label">{{ t('deck.allowed_modes_label') }}</label>
          <div class="checkbox-grid">
            <label class="checkbox-card">
              <input
                type="checkbox"
                name="allowed_modes[]"
                value="chronometre"
                {{ !deck.allowed_modes || deck.allowed_modes.includes('chronometre') ? 'checked' : '' }}
              />
              {{ t('deck.mode_chrono') }} ⏱
          </label>
            <label class="checkbox-card">
              <input
                type="checkbox"
                name="allowed_modes[]"
                value="basique"
                {{ !deck.allowed_modes || deck.allowed_modes.includes('basique') ? 'checked' : '' }}
              />
              {{ t('deck.mode_basic') }} 📝
          </label>
            <label class="checkbox-card">
              <input
                type="checkbox"
                name="allowed_modes[]"
                value="jusquaubout"
                {{ !deck.allowed_modes || deck.allowed_modes.includes('jusquaubout') ? 'checked' : '' }}
              />
              {{ t('deck.mode_until_done') }} 🔥
          </label>
            <label class="checkbox-card">
              <input
                type="checkbox"
                name="allowed_modes[]"
                value="quiz"
                {{ !deck.allowed_modes || deck.allowed_modes.includes('quiz') ? 'checked' : '' }}
              />
              {{ t('deck.mode_quiz') }} ❓
          </label>
          </div>
        </div>

        <!-- Tentatives -->
        <div class="form-group">
          <label class="form-label" for="attempt_limit">{{ t('deck.attempt_limit_label') }}</label>
          <input
            class="form-input"
            type="number"
            id="attempt_limit"
            name="attempt_limit"
            min="1"
            placeholder="{{ t('deck.attempt_limit_placeholder') }}"
            value="{{ deck.attempt_limit !== null ? deck.attempt_limit : '' }}"
          />
          <div class="form-helper">
            {{ t('deck.attempt_limit_help') }}
          </div>
        </div>

        <div class="actions">
          <!-- CORRECTED LINK FROM route('home') TO route('decks.show', {id: deck.id}) -->
          <button
            type="button"
            class="btn btn-secondary"
            onclick="window.location.href='{{ route('decks.show', { id: deck.id }) }}'"
          >
            {{ t('deck.cancel_btn') }}
        </button>
          <button type="submit" class="btn btn-primary">
            {{ t('deck.save_btn') }}
        </button>
        </div>
      </form>
    </div>

    <script>
      const textarea = document.getElementById("description");
      
      const charCount = document.getElementById("charCount");
      
      function updateCounter() {
        const currentLength = textarea.value.length;
        charCount.textContent = currentLength;
        if (currentLength >= 100) charCount.style.color = "#ef4444"; else if (currentLength >= 80) charCount.style.color = "#f59e0b"; else charCount.style.color = "inherit";
      }
      
      document.addEventListener("DOMContentLoaded", updateCounter);
      
      textarea.addEventListener("input", updateCounter);
    </script>
  </body>
</html>
